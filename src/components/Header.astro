---
import { SITE_CONFIG } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200">
  <div class="container-custom">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group focus-visible:ring-2 focus-visible:ring-brand-blue rounded-xl py-1 px-1.5 -ml-1.5" aria-label="DormReady Home">
        <div class="w-10 h-10 rounded-xl bg-brand-blue flex items-center justify-center text-white font-bold text-lg shadow-sm group-hover:bg-brand-blue-600 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 10v11h18V10" />
            <path d="M2 10l10-7 10 7" />
            <path d="M9 21V12h6v9" />
          </svg>
        </div>
        <div>
          <span class="font-black text-xl sm:text-2xl tracking-tight text-brand-navy font-sans block leading-none">
            Dorm<span class="text-brand-coral">Ready</span>
          </span>
          <span class="text-[10px] text-navy-500 uppercase tracking-wider font-bold block mt-0.5">U.S. College Prep</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main Navigation">
        {SITE_CONFIG.nav.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3.5 py-2 rounded-xl text-sm font-semibold transition-all ${
                isActive
                  ? 'bg-brand-blue-50 text-brand-blue-700 shadow-sm border border-brand-blue-100'
                  : 'text-navy-700 hover:text-brand-navy hover:bg-slate-100/80'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- CTA & Mobile Toggle Button -->
      <div class="flex items-center gap-3">
        <a
          href="/college-dorm-checklist/"
          class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-blue text-white text-sm font-bold hover:bg-brand-blue-600 transition-all shadow-sm hover:shadow-soft"
        >
          <span>Dorm Checklist</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2 rounded-xl text-navy-700 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
        >
          <svg class="w-6 h-6 block menu-open-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 hidden menu-close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div id="mobile-nav-panel" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-2 shadow-lg">
    <div class="grid grid-cols-1 gap-1">
      {SITE_CONFIG.nav.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`block px-3 py-2.5 rounded-xl text-base font-semibold transition-colors ${
              isActive
                ? 'bg-brand-blue-50 text-brand-blue-700 border border-brand-blue-100'
                : 'text-navy-800 hover:bg-slate-50'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </div>
    <div class="pt-3 border-t border-slate-100">
      <a
        href="/college-dorm-checklist/"
        class="flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-brand-blue text-white text-base font-bold hover:bg-brand-blue-600 shadow-sm"
      >
        <span>Open Interactive Checklist</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-nav-panel');
  const openIcon = document.querySelector('.menu-open-icon');
  const closeIcon = document.querySelector('.menu-close-icon');

  if (btn && panel && openIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      panel.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
