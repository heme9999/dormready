---
import { SITE_CONFIG } from '../data/site';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FaqItem[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  breadcrumbs = [],
  faqs = [],
  noindex = false,
} = Astro.props;

const fullTitle = title.includes('DormReady') ? title : `${title} | DormReady`;
const finalCanonical = canonicalUrl || new URL(Astro.url.pathname, SITE_CONFIG.url).href;
const shouldNoIndex = noindex || SITE_CONFIG.isNoIndex;
const ogImageUrl = `${SITE_CONFIG.url}/images/dormready-og.png`;
const ogImageAlt = 'DormReady - Practical, Honest College Dorm Planning and Checklists';

// JSON-LD schemas
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DormReady',
  url: SITE_CONFIG.url,
  logo: `${SITE_CONFIG.url}/favicon.svg`,
  description: SITE_CONFIG.description,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DormReady',
  url: SITE_CONFIG.url,
  description: SITE_CONFIG.description,
};

let breadcrumbSchema = null;
if (breadcrumbs.length > 0) {
  breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: crumb.name,
      item: crumb.url.startsWith('http') ? crumb.url : `${SITE_CONFIG.url}${crumb.url}`,
    })),
  };
}

let articleSchema = null;
if (ogType === 'article') {
  articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: description,
    image: ogImageUrl,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': finalCanonical,
    },
    datePublished: publishedTime || modifiedTime || SITE_CONFIG.lastSiteUpdate,
    dateModified: modifiedTime || SITE_CONFIG.lastSiteUpdate,
    author: {
      '@type': 'Organization',
      name: 'DormReady Editorial Team',
      url: `${SITE_CONFIG.url}/about/`,
    },
    publisher: {
      '@type': 'Organization',
      name: 'DormReady',
      logo: {
        '@type': 'ImageObject',
        url: `${SITE_CONFIG.url}/favicon.svg`,
      },
    },
  };
}

let faqSchema = null;
if (faqs.length > 0) {
  faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  };
}
---

<!-- Essential Meta Tags -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={finalCanonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Indexing Control -->
{shouldNoIndex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={finalCanonical} />
<meta property="og:site_name" content="DormReady" />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Structured Data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
{breadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
{articleSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
{faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
