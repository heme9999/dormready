---
import type { GuideMeta } from '../data/guides';
import GuideThumbnail from './GuideThumbnail.astro';

export interface Props {
  guide: GuideMeta;
  showCategory?: boolean;
  className?: string;
}

const { guide, showCategory = true, className = '' } = Astro.props;
---

<article class={`flex flex-col bg-white border-2 border-slate-200 hover:border-brand-blue-300 rounded-3xl overflow-hidden shadow-soft hover:shadow-soft-hover transition-all duration-200 hover:-translate-y-1 group ${className}`}>
  <!-- 16:9 Topic-Specific Thumbnail -->
  <a href={guide.href} class="block focus:outline-none overflow-hidden" tabindex="-1" aria-hidden="true">
    <GuideThumbnail slug={guide.slug} title={guide.title} />
  </a>

  <div class="p-6 flex flex-col flex-1 justify-between">
    <div>
      <div class="flex items-center justify-between gap-2 text-xs mb-3">
        {showCategory && (
          <span class="inline-block px-2.5 py-0.5 rounded-full font-bold bg-brand-blue-50 text-brand-blue-700 border border-brand-blue-200">
            {guide.categoryLabel}
          </span>
        )}
        <span class="ml-auto font-semibold text-navy-500">{guide.readingTimeMinutes} min read</span>
      </div>

      <h3 class="text-lg sm:text-xl font-black text-brand-navy group-hover:text-brand-blue transition-colors leading-snug mb-2">
        <a href={guide.href} class="focus:outline-none focus-visible:underline">
          {guide.title}
        </a>
      </h3>

      <p class="text-xs sm:text-sm text-navy-600 leading-relaxed mb-4">
        {guide.description}
      </p>

      {guide.summaryPoints && guide.summaryPoints.length > 0 && (
        <ul class="text-xs text-navy-600 space-y-1 mb-4 border-t border-slate-100 pt-3">
          {guide.summaryPoints.slice(0, 2).map((point) => (
            <li class="flex items-start gap-1.5 truncate">
              <span class="text-brand-mint font-bold">✓</span>
              <span class="truncate">{point}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-navy-500">
      <span>Updated: <time datetime={guide.lastUpdated}>{guide.lastUpdated}</time></span>
      <a
        href={guide.href}
        class="text-brand-blue font-bold flex items-center gap-1 group-hover:translate-x-1 transition-transform"
      >
        <span>Read Guide</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</article>
