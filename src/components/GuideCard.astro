---
import type { GuideMeta } from '../data/guides';

export interface Props {
  guide: GuideMeta;
  showCategory?: boolean;
}

const { guide, showCategory = true } = Astro.props;
---

<article class="flex flex-col bg-white border border-cream-300 rounded-xl p-5 sm:p-6 shadow-sm hover:shadow-md hover:border-forest-700/40 transition-all group">
  <div class="flex items-center justify-between gap-2 text-xs text-navy-500 mb-2.5">
    {showCategory && (
      <span class="inline-block px-2.5 py-0.5 rounded-full font-semibold bg-cream-200 text-forest-900">
        {guide.categoryLabel}
      </span>
    )}
    <span class="ml-auto font-medium">{guide.readingTimeMinutes} min read</span>
  </div>

  <h3 class="text-lg sm:text-xl font-bold text-navy-900 group-hover:text-forest-800 transition-colors leading-snug mb-2">
    <a href={guide.href} class="focus:outline-none">
      <span class="absolute inset-0" aria-hidden="true"></span>
      {guide.title}
    </a>
  </h3>

  <p class="text-sm text-navy-600 leading-relaxed mb-4 flex-1">
    {guide.description}
  </p>

  {guide.summaryPoints && guide.summaryPoints.length > 0 && (
    <ul class="text-xs text-navy-500 space-y-1 mb-4 border-t border-cream-200 pt-3 list-disc list-inside">
      {guide.summaryPoints.slice(0, 2).map((point) => (
        <li class="truncate">{point}</li>
      ))}
    </ul>
  )}

  <div class="mt-auto pt-3 border-t border-cream-200 flex items-center justify-between text-xs text-navy-500">
    <span>Updated: <time datetime={guide.lastUpdated}>{guide.lastUpdated}</time></span>
    <span class="text-forest-800 font-semibold flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
      Read guide <span aria-hidden="true">&rarr;</span>
    </span>
  </div>
</article>
