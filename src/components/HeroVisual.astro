---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`relative w-full rounded-3xl overflow-hidden shadow-soft border-2 border-brand-blue-100 bg-brand-blue-50 ${className}`}>
  <!-- Interactive Header Tags -->
  <div class="absolute top-4 left-4 right-4 z-10 flex items-center justify-between pointer-events-none">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-white/95 text-brand-navy shadow-sm border border-brand-blue-200 backdrop-blur-sm">
      <span class="w-2 h-2 rounded-full bg-brand-mint animate-pulse"></span>
      Realistic Shared Double Room
    </span>
    <span class="hidden sm:inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-blue/10 text-brand-blue-700">
      Twin XL Standard
    </span>
  </div>

  <img
    src="/images/hero-dorm-movein.svg"
    alt="Detailed illustration of an organized college dorm room featuring a Twin XL bed with mattress topper, under-bed storage bins, study desk with laptop and lamp, surge protector, shower caddy, and labeled move-in packing boxes."
    width="720"
    height="520"
    loading="eager"
    fetchpriority="high"
    class="w-full h-auto object-contain select-none"
  />

  <!-- Bottom Interactive Pill Legend -->
  <div class="p-3 bg-white border-t border-brand-blue-100 flex flex-wrap items-center justify-around gap-2 text-xs font-semibold text-brand-navy">
    <div class="flex items-center gap-1.5">
      <span class="w-3 h-3 rounded-full bg-brand-coral"></span>
      <span>1. Essentials First</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="w-3 h-3 rounded-full bg-brand-blue"></span>
      <span>2. Coordinate Roommates</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="w-3 h-3 rounded-full bg-brand-mint"></span>
      <span>3. Stack Student Discounts</span>
    </div>
  </div>
</div>
