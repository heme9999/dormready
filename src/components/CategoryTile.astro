---
import type { ChecklistCategory } from '../data/checklist';
import { CHECKLIST_ITEMS } from '../data/checklist';

interface Props {
  category: ChecklistCategory;
  className?: string;
}

const { category, className = '' } = Astro.props;

const count = CHECKLIST_ITEMS.filter((i) => i.category === category.key).length;

const colorStyles: Record<string, { bg: string; border: string; iconBg: string; text: string; badge: string }> = {
  bedding: {
    bg: 'bg-brand-blue-50/70 hover:bg-brand-blue-50',
    border: 'border-brand-blue-100 hover:border-brand-blue-300',
    iconBg: 'bg-brand-blue text-white',
    text: 'text-brand-blue-900',
    badge: 'bg-white text-brand-blue-700 border-brand-blue-200',
  },
  bathroom: {
    bg: 'bg-brand-mint-50/70 hover:bg-brand-mint-50',
    border: 'border-brand-mint-100 hover:border-brand-mint-300',
    iconBg: 'bg-brand-mint text-white',
    text: 'text-emerald-950',
    badge: 'bg-white text-brand-mint-700 border-brand-mint-200',
  },
  laundry: {
    bg: 'bg-brand-coral-50/70 hover:bg-brand-coral-50',
    border: 'border-brand-coral-100 hover:border-brand-coral-300',
    iconBg: 'bg-brand-coral text-white',
    text: 'text-rose-950',
    badge: 'bg-white text-brand-coral-700 border-brand-coral-200',
  },
  study: {
    bg: 'bg-brand-yellow-50/70 hover:bg-brand-yellow-50',
    border: 'border-brand-yellow-100 hover:border-brand-yellow-300',
    iconBg: 'bg-amber-500 text-white',
    text: 'text-amber-950',
    badge: 'bg-white text-amber-800 border-amber-200',
  },
  technology: {
    bg: 'bg-brand-blue-50/70 hover:bg-brand-blue-50',
    border: 'border-brand-blue-100 hover:border-brand-blue-300',
    iconBg: 'bg-brand-blue text-white',
    text: 'text-brand-blue-900',
    badge: 'bg-white text-brand-blue-700 border-brand-blue-200',
  },
  kitchen: {
    bg: 'bg-brand-coral-50/70 hover:bg-brand-coral-50',
    border: 'border-brand-coral-100 hover:border-brand-coral-300',
    iconBg: 'bg-brand-coral text-white',
    text: 'text-rose-950',
    badge: 'bg-white text-brand-coral-700 border-brand-coral-200',
  },
  clothing: {
    bg: 'bg-brand-mint-50/70 hover:bg-brand-mint-50',
    border: 'border-brand-mint-100 hover:border-brand-mint-300',
    iconBg: 'bg-brand-mint text-white',
    text: 'text-emerald-950',
    badge: 'bg-white text-brand-mint-700 border-brand-mint-200',
  },
  health: {
    bg: 'bg-brand-coral-50/70 hover:bg-brand-coral-50',
    border: 'border-brand-coral-100 hover:border-brand-coral-300',
    iconBg: 'bg-brand-coral text-white',
    text: 'text-rose-950',
    badge: 'bg-white text-brand-coral-700 border-brand-coral-200',
  },
  documents: {
    bg: 'bg-slate-50 hover:bg-slate-100/80',
    border: 'border-slate-200 hover:border-slate-400',
    iconBg: 'bg-brand-navy text-white',
    text: 'text-brand-navy',
    badge: 'bg-white text-brand-navy border-slate-200',
  },
  optional: {
    bg: 'bg-brand-yellow-50/70 hover:bg-brand-yellow-50',
    border: 'border-brand-yellow-100 hover:border-brand-yellow-300',
    iconBg: 'bg-amber-500 text-white',
    text: 'text-amber-950',
    badge: 'bg-white text-amber-800 border-amber-200',
  },
};

const style = colorStyles[category.key] || colorStyles.bedding;
---

<a
  href={`/college-dorm-checklist/#${category.key}`}
  class={`group flex flex-col justify-between p-5 rounded-2xl border-2 transition-all duration-200 hover:-translate-y-1 hover:shadow-soft-hover ${style.bg} ${style.border} ${className}`}
>
  <div>
    <div class="flex items-center justify-between mb-3">
      <div class={`w-10 h-10 rounded-xl flex items-center justify-center font-bold shadow-sm ${style.iconBg}`}>
        {category.key === 'bedding' && '🛏️'}
        {category.key === 'bathroom' && '🚿'}
        {category.key === 'laundry' && '🧺'}
        {category.key === 'study' && '📚'}
        {category.key === 'technology' && '⚡'}
        {category.key === 'kitchen' && '🍽️'}
        {category.key === 'clothing' && '👕'}
        {category.key === 'health' && '💊'}
        {category.key === 'documents' && '📄'}
        {category.key === 'optional' && '✨'}
      </div>
      <span class={`text-xs font-bold px-2.5 py-0.5 rounded-full border shadow-sm ${style.badge}`}>
        {count} items
      </span>
    </div>
    <h3 class={`text-base font-bold mb-1 transition-colors ${style.text}`}>
      {category.name}
    </h3>
    <p class="text-xs text-navy-600 leading-relaxed">
      {category.description}
    </p>
  </div>

  <div class="mt-4 pt-3 border-t border-black/5 flex items-center justify-between text-xs font-semibold text-brand-blue group-hover:translate-x-0.5 transition-transform">
    <span>View checklist items</span>
    <span>→</span>
  </div>
</a>
