---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_CONFIG } from '../data/site';

const breadcrumbs = [
  { name: 'Terms of Use', url: '/terms/' },
];
---

<BaseLayout
  title="Terms of Use | DormReady"
  description="DormReady Terms of Use. Guidelines for using our dorm planning tools, checklists, and editorial guides."
  breadcrumbs={breadcrumbs}
>
  <div class="bg-gradient-to-b from-brand-blue-50/60 via-brand-blue-50/30 to-white border-b border-slate-200 py-10 sm:py-14">
    <div class="container-custom max-w-4xl">
      <Breadcrumbs items={breadcrumbs} />

      <span class="mt-4 badge-blue">
        Starter Terms — Development Notice
      </span>

      <h1 class="mt-4 text-3xl sm:text-5xl font-black text-brand-navy leading-tight">
        Terms of Use
      </h1>

      <p class="mt-4 text-base sm:text-lg text-navy-700 leading-relaxed font-sans">
        Last updated: August 17, 2026. Please read these starter terms carefully before using DormReady.
      </p>
    </div>
  </div>

  <div class="container-custom max-w-4xl py-10 lg:py-14 space-y-8 text-xs sm:text-sm leading-relaxed text-navy-800">
    <div class="p-5 bg-brand-yellow-50 border-2 border-brand-yellow-200 rounded-2xl text-xs sm:text-sm text-amber-950 font-medium shadow-soft">
      <strong>Legal Notice:</strong> This document is a starter terms of service template provided for development and preview purposes. It must undergo formal review by qualified legal counsel prior to full commercial operation.
    </div>

    <section class="space-y-3">
      <h2 class="text-xl font-black text-brand-navy">1. Informational Purpose Only</h2>
      <p>
        DormReady provides educational guides, checklists, and hardware reference profiles for college freshmen and families. We are not affiliated with any specific college, university, or residence life authority.
      </p>
      <p>
        <strong>Safety &amp; Policy Disclaimer:</strong> Housing policies, electrical limits, and prohibited items vary by institution. Users are strictly responsible for verifying specific residence hall regulations with their enrolled institution before purchasing appliances or electrical equipment.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-black text-brand-navy">2. Intellectual Property &amp; Printable Tools</h2>
      <p>
        The content, organization, interactive checklist applications, and editorial frameworks on DormReady are protected by copyright. You may print and export individual checklists for personal, non-commercial use.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-black text-brand-navy">3. Limitation of Liability</h2>
      <p>
        DormReady is provided on an "as is" and "as available" basis without warranties of any kind. We make reasonable efforts to verify discount promotions and product standards, but cannot guarantee continuous accuracy or merchant offer availability.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-black text-brand-navy">4. Contact &amp; Open Issues</h2>
      <p>
        Questions regarding terms of use should be submitted via our <a href={SITE_CONFIG.githubRepoUrl} target="_blank" rel="noopener noreferrer" class="underline font-bold text-brand-blue">GitHub Repository</a>.
      </p>
    </section>
  </div>
</BaseLayout>
