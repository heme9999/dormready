---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Terms of Use', url: '/terms/' },
];
---

<BaseLayout
  title="Terms of Use | DormReady"
  description="DormReady Terms of Use. Guidelines for using our dorm planning tools, checklists, and editorial guides."
  breadcrumbs={breadcrumbs}
>
  <div class="bg-cream-100 border-b border-cream-300 py-8 sm:py-12">
    <div class="container-custom max-w-4xl">
      <Breadcrumbs items={breadcrumbs} />

      <span class="mt-4 inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-900 border border-amber-200">
        Starter Terms — Pending Legal Review
      </span>

      <h1 class="mt-4 text-3xl sm:text-5xl font-bold font-serif text-navy-900 leading-tight">
        Terms of Use
      </h1>

      <p class="mt-4 text-base sm:text-lg text-navy-700 leading-relaxed font-sans">
        Last updated: August 15, 2026. Please read these starter terms carefully before using DormReady.
      </p>
    </div>
  </div>

  <div class="container-custom max-w-4xl py-10 lg:py-14 space-y-8 text-base leading-relaxed text-navy-800">
    <div class="p-4 bg-amber-50 border border-amber-300 rounded-xl text-xs sm:text-sm text-amber-950">
      <strong>Notice:</strong> This document is a starter terms of service template provided for development and preview purposes. It must undergo formal review by qualified legal counsel prior to full commercial operation.
    </div>

    <section class="space-y-3">
      <h2 class="text-xl font-bold font-serif text-navy-900">1. Informational Purpose Only</h2>
      <p>
        DormReady provides educational guides, checklists, and hardware reference profiles for college freshmen and families. We are not affiliated with any specific college, university, or residence life authority.
      </p>
      <p>
        <strong>Safety & Policy Disclaimer:</strong> Housing policies, electrical limits, and prohibited items vary by institution. Users are strictly responsible for verifying specific residence hall regulations with their enrolled institution before purchasing appliances or electrical equipment.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-bold font-serif text-navy-900">2. Intellectual Property & Printable Tools</h2>
      <p>
        The content, organization, interactive checklist applications, and editorial frameworks on DormReady are protected by copyright. You may print and export individual checklists for personal, non-commercial use.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-bold font-serif text-navy-900">3. Limitation of Liability</h2>
      <p>
        DormReady is provided on an "as is" and "as available" basis without warranties of any kind. We make reasonable efforts to verify discount promotions and product standards, but cannot guarantee continuous accuracy or merchant offer availability.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-bold font-serif text-navy-900">4. Contact Information</h2>
      <p>
        For inquiries regarding these terms, please contact <a href="mailto:editorial@dormready.org" class="underline text-forest-800">editorial@dormready.org</a>.
      </p>
    </section>
  </div>
</BaseLayout>
