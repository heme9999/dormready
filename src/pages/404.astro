---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: '404 Page Not Found', url: '/404' },
];
---

<BaseLayout
  title="Page Not Found (404) | DormReady"
  description="Sorry, the dorm preparation page you are looking for does not exist or has been moved."
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <div class="container-custom py-16 sm:py-24 text-center max-w-2xl">
    <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300 mb-4">
      Error 404
    </span>

    <h1 class="text-4xl sm:text-6xl font-bold font-serif text-navy-900 mb-4">
      Lost on Campus?
    </h1>

    <p class="text-base sm:text-lg text-navy-600 mb-8 leading-relaxed">
      We couldn't find the page or checklist you requested. It may have been relocated or updated for the current academic year.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-md mx-auto mb-10 text-left">
      <a
        href="/college-dorm-checklist/"
        class="p-4 bg-white border border-cream-300 rounded-xl hover:border-forest-700 hover:shadow-sm transition-all"
      >
        <span class="text-xs font-bold text-forest-800 block mb-1">Essential Tool</span>
        <strong class="text-sm text-navy-900 block">Interactive Dorm Checklist</strong>
        <span class="text-xs text-navy-500">Track all 9 categories with browser saving</span>
      </a>

      <a
        href="/college-packing-list/"
        class="p-4 bg-white border border-cream-300 rounded-xl hover:border-forest-700 hover:shadow-sm transition-all"
      >
        <span class="text-xs font-bold text-forest-800 block mb-1">Strategic Guide</span>
        <strong class="text-sm text-navy-900 block">College Packing List</strong>
        <span class="text-xs text-navy-500">What to bring vs buy after arrival</span>
      </a>
    </div>

    <div>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-forest-800 text-cream-50 font-semibold text-sm hover:bg-forest-900 transition-colors shadow-sm"
      >
        <span>Return to Homepage</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>
