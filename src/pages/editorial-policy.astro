---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import VisualCallout from '../components/VisualCallout.astro';
import { SITE_CONFIG } from '../data/site';

const breadcrumbs = [
  { name: 'Editorial Policy', url: '/editorial-policy/' },
];
---

<BaseLayout
  title="Editorial Policy & Fact-Checking Standards | DormReady"
  description="DormReady's comprehensive editorial standards: research methodology, product selection rules, affiliate disclosure principles, and correction policy."
  breadcrumbs={breadcrumbs}
>
  <div class="bg-gradient-to-b from-brand-mint-50/60 via-brand-mint-50/30 to-white border-b border-slate-200 py-10 sm:py-14">
    <div class="container-custom max-w-4xl">
      <Breadcrumbs items={breadcrumbs} />

      <span class="mt-4 badge-mint">
        Editorial Integrity
      </span>

      <h1 class="mt-4 text-3xl sm:text-5xl font-black text-brand-navy leading-tight">
        Editorial Policy &amp; Standards
      </h1>

      <p class="mt-4 text-base sm:text-lg text-navy-700 leading-relaxed font-sans">
        Trust is our core asset. This policy outlines how DormReady structures dorm gear advice, audits student discounts, handles future affiliate relationships, and manages corrections.
      </p>
    </div>
  </div>

  <div class="container-custom max-w-4xl py-10 lg:py-14 space-y-12 text-xs sm:text-sm leading-relaxed text-navy-800">
    <!-- Visual Editorial Lifecycle Diagram -->
    <section class="space-y-4">
      <h2 class="text-xl sm:text-2xl font-black text-brand-navy">Editorial Review Lifecycle</h2>
      <img
        src="/images/diagrams/editorial-flow.svg"
        alt="DormReady 3-stage editorial review flow: Fire Code Audit, Spatial Reality Check, and Verified Merchant Terms"
        width="680"
        height="140"
        class="w-full h-auto rounded-2xl border-2 border-brand-mint-200 shadow-soft"
      />
    </section>

    <!-- Section 1: Research Process -->
    <section class="space-y-4">
      <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">1. Our Research Process</h2>
      <p>
        Our editorial team analyzes residence hall life through four primary lenses:
      </p>
      <ol class="list-decimal list-inside space-y-2 text-navy-700 font-medium">
        <li><strong>Physical Spatial Constraints:</strong> Double room layouts and furniture configurations vary widely across campuses. Products that create clutter or cannot be folded/stacked are filtered out.</li>
        <li><strong>Institutional Fire &amp; Safety Codes:</strong> We cross-reference typical university residence policies across public, private, and regional colleges to ensure suggested items (e.g. UL-listed surge protectors, auto-shutoff kettles) comply with campus safety standards.</li>
        <li><strong>Academic Durability:</strong> College gear must withstand 9 months of intensive daily use, frequent moves between semesters, and transport in campus laundry facilities.</li>
        <li><strong>Total Cost of Ownership:</strong> We prioritize products that provide lasting utility across multiple academic years rather than single-use novelties.</li>
      </ol>
    </section>

    <!-- Section 2: Fact-Checking Standards -->
    <section class="space-y-4">
      <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">2. Fact-Checking &amp; Verification</h2>
      <p>
        We hold every factual assertion on DormReady to strict standards:
      </p>
      <ul class="list-disc list-inside space-y-2 text-navy-700">
        <li><strong>No Fabricated Ratings or Testimonials:</strong> We never generate artificial star ratings, fake student quotes, or synthetic lab scores.</li>
        <li><strong>Explicit Specification Labels:</strong> All hardware reference baselines or specification targets are clearly labeled to prevent confusion with lab benchmark results.</li>
        <li><strong>Discount Audits:</strong> Student discounts must be audited against official vendor terms (e.g., SheerID, UNiDAYS, Apple Education) with logged check dates and direct links.</li>
      </ul>
    </section>

    <VisualCallout type="tip" title="Submit Corrections &amp; Rule Updates">
      <p>
        Have a college housing policy update, broken merchant link, or correction? Submit an issue directly on our open <a href={SITE_CONFIG.githubRepoUrl} target="_blank" rel="noopener noreferrer" class="underline font-bold text-brand-blue">GitHub Repository</a>.
      </p>
    </VisualCallout>
  </div>
</BaseLayout>
