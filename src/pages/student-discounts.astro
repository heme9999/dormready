---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DiscountDirectory from '../components/DiscountDirectory';

const breadcrumbs = [
  { name: 'Student Discounts', url: '/student-discounts/' },
];

const faqs = [
  {
    question: 'How do third-party student verification platforms like SheerID and UNiDAYS work?',
    answer: 'Platforms like SheerID and UNiDAYS verify your active student status by connecting directly to the National Student Clearinghouse or by validating your institution-issued .edu email and student ID document. Once verified, they generate a single-use promo code or unlock education storefront pricing.',
  },
  {
    question: 'Can incoming freshmen get student discounts before school starts in August?',
    answer: 'Yes. As soon as you receive your official university .edu email address or admission acceptance letter, you can register for GitHub Student Developer Pack, Apple Education pricing, Spotify Student, and Amazon Prime Student.',
  },
];
---

<BaseLayout
  title="Verified Student Discounts Directory: Software, Tech, and Services | DormReady"
  description="Audited student discounts for college freshmen. Verified educational rates for Apple, GitHub Student Developer Pack, Spotify Student with Hulu, and Amazon Prime."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="bg-cream-100 border-b border-cream-300 py-8 sm:py-12">
    <div class="container-custom max-w-5xl">
      <Breadcrumbs items={breadcrumbs} />

      <span class="mt-4 inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-forest-50 text-forest-800 border border-forest-100">
        Audited Education Deals
      </span>

      <h1 class="mt-4 text-3xl sm:text-5xl font-bold font-serif text-navy-900 leading-tight">
        Verified College Student Discounts
      </h1>

      <p class="mt-4 text-base sm:text-lg text-navy-700 leading-relaxed font-sans max-w-3xl">
        Every discount below has been checked against its official merchant terms. We record the exact verification platform (SheerID, UNiDAYS, or direct .edu email), eligibility criteria, and last audit date.
      </p>
    </div>
  </div>

  <div class="container-custom max-w-5xl py-8 sm:py-12">
    <!-- Interactive Client Directory -->
    <DiscountDirectory client:load />

    <!-- Static Educational Content -->
    <div class="mt-16 pt-12 border-t border-cream-300 space-y-12">
      <section class="max-w-4xl space-y-4">
        <h2 class="text-2xl font-bold font-serif text-navy-900">How to Maximize Your College Student Benefits</h2>
        <div class="prose prose-slate text-sm sm:text-base text-navy-700 leading-relaxed space-y-3">
          <p>
            Your college student status grants you access to meaningful savings on developer tools, digital subscriptions, and academic hardware. Here is how to take advantage:
          </p>
          <ul class="list-disc list-inside space-y-2">
            <li><strong>Check Your Campus Software Portal Before Buying:</strong> Most major universities provide complimentary licenses for Microsoft Office 365, MATLAB, Adobe Creative Cloud, and Zoom Pro through institutional site licenses. Check with your university IT service desk before purchasing software independently.</li>
            <li><strong>Keep Your .edu Email Active:</strong> Set up email forwarding from your university account to your primary inbox so you never miss annual renewal re-verification emails from SheerID or UNiDAYS.</li>
            <li><strong>Verify In-Store With Physical Student ID:</strong> Many local coffee shops, museums, transit systems, and apparel stores offer 10%–15% student discounts at checkout upon displaying your student ID card.</li>
          </ul>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="max-w-4xl space-y-6">
        <h2 class="text-2xl font-bold font-serif text-navy-900">Student Discount Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="p-5 bg-white border border-cream-300 rounded-xl">
              <h3 class="font-bold text-navy-900 text-base mb-2">{faq.question}</h3>
              <p class="text-sm text-navy-700 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
