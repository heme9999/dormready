---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DiscountDirectory from '../components/DiscountDirectory';
import VisualCallout from '../components/VisualCallout.astro';

const breadcrumbs = [
  { name: 'Student Discounts', url: '/student-discounts/' },
];

const faqs = [
  {
    question: 'How do third-party student verification platforms like SheerID and UNiDAYS work?',
    answer: 'Platforms like SheerID and UNiDAYS verify active enrollment through institution-issued .edu email credentials, registrar enrollment records, student ID uploads, or tuition receipt validation. Once verified, they unlock educational storefront pricing or generate single-use discount codes.',
  },
  {
    question: 'Can incoming freshmen get student discounts before school starts in August?',
    answer: 'Yes. As soon as you receive your official university .edu email address or admission acceptance letter, you can register for GitHub Student Developer Pack, Apple Education pricing, Spotify Student, and Amazon Prime Student.',
  },
];
---

<BaseLayout
  title="Verified Student Discounts Directory: Software, Tech, and Services | DormReady"
  description="Audited student discounts for college freshmen. Verified educational rates for Apple, GitHub Student Developer Pack, Spotify Student with Hulu, and Amazon Prime."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="bg-gradient-to-b from-brand-coral-50 via-brand-coral-50/50 to-white border-b border-slate-200 py-10 sm:py-14">
    <div class="container-custom max-w-5xl">
      <Breadcrumbs items={breadcrumbs} />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mt-6">
        <div class="lg:col-span-8 space-y-4">
          <div class="flex flex-wrap items-center gap-2.5 text-xs font-bold text-navy-600">
            <span class="badge-coral">
              Audited Education Deals
            </span>
            <span>•</span>
            <span class="text-brand-navy">SheerID &amp; UNiDAYS Verified</span>
            <span>•</span>
            <span>Last audited: <time datetime="2026-08-17" class="text-brand-blue">August 17, 2026</time></span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-brand-navy leading-tight">
            Verified College Student Discounts
          </h1>

          <p class="text-base sm:text-lg text-navy-700 leading-relaxed font-sans max-w-2xl">
            Every discount below has been checked against its official merchant terms. We record the exact verification platform (SheerID, UNiDAYS, or direct .edu email), eligibility criteria, and last audit date.
          </p>
        </div>

        <div class="lg:col-span-4 hidden lg:block">
          <img
            src="/images/guides/student-discounts.svg"
            alt="Student ID card with verified discount tags"
            width="640"
            height="360"
            class="w-full h-auto rounded-3xl border-2 border-brand-coral-200 shadow-soft"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="container-custom max-w-5xl py-8 sm:py-12">
    <!-- Interactive Client Directory -->
    <DiscountDirectory client:load />

    <!-- Static Educational Content -->
    <div class="mt-16 pt-12 border-t border-slate-200 space-y-12">
      <section class="max-w-4xl space-y-4">
        <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">How to Maximize Your College Student Benefits</h2>

        <VisualCallout type="action" title="Check Your Campus Software Portal Before Buying">
          <p>
            Most major universities provide complimentary licenses for <strong>Microsoft Office 365, MATLAB, Adobe Creative Cloud, and Zoom Pro</strong> through institutional site licenses. Log into your university's official IT portal before purchasing any student software bundle independently.
          </p>
        </VisualCallout>

        <VisualCallout type="tip" title="Set Up Email Forwarding For Annual Renewals">
          <p>
            Platforms like SheerID and UNiDAYS require annual re-verification. Set up email forwarding from your student <code>.edu</code> account to your phone so you never miss renewal notices or get charged standard pricing.
          </p>
        </VisualCallout>
      </section>

      <!-- Frequently Asked Questions -->
      <section class="max-w-4xl space-y-6">
        <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">
          Student Discount Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="p-6 bg-white border-2 border-slate-200 rounded-2xl shadow-soft">
              <h3 class="font-bold text-brand-navy text-base mb-2">{faq.question}</h3>
              <p class="text-xs sm:text-sm text-navy-700 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
