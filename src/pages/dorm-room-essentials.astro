---
import GuideLayout from '../layouts/GuideLayout.astro';
import DormZoneDiagram from '../components/DormZoneDiagram.astro';
import VisualCallout from '../components/VisualCallout.astro';
import PolicyNotice from '../components/PolicyNotice.astro';

const guide = {
  title: 'Dorm Room Essentials Organized by Real Daily Need',
  description: 'A realistic, practical room setup guide focusing on sleep hygiene, study ergonomics, and functional storage rather than aesthetic clutter.',
  category: 'Essentials Guide',
  categoryUrl: '/dorm-room-essentials/',
  lastUpdated: '2026-08-17',
  readingTimeMinutes: 9,
  currentSlug: 'dorm-room-essentials',
};

const faqs = [
  {
    question: 'Why is a mattress encasement protector necessary in dorms?',
    answer: 'Dorm mattresses have been used by multiple students over many years. A full zippered waterproof encasement creates a sealed physical barrier against allergens, dust mites, and stains.',
  },
  {
    question: 'How do I optimize storage under a lofted or unlofted dorm bed?',
    answer: 'Clearance under dorm beds varies widely depending on whether frames are junior-lofted, fully lofted, or non-adjustable. Measure your clearance during move-in before purchasing rigid plastic drawers; low-profile zippered under-bed bags accommodate variable heights easily.',
  },
];
---

<GuideLayout {...guide} faqs={faqs}>
  <div class="space-y-8 text-base leading-relaxed">
    <PolicyNotice topic="prohibited appliances and room decor" />

    <!-- Intro block -->
    <div class="p-6 bg-brand-mint-50 border-2 border-brand-mint-200 rounded-3xl shadow-soft">
      <h2 class="text-lg font-black text-emerald-950 mb-2">
        Why Most "Dorm Essentials" Lists Fail Students
      </h2>
      <p class="text-xs sm:text-sm text-navy-700 leading-relaxed">
        Typical retail blogs publish bloated lists packed with novelty gadgets that end up discarded by semester end. Our guide prioritizes items that solve practical daily challenges: <strong>mattress firmness, communal bathroom hygiene, electrical safety, closet organization, and study focus</strong>.
      </p>
    </div>

    <!-- 5 Functional Dorm Zones Blueprint -->
    <section class="space-y-6">
      <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">
        The 5 Functional Dorm Zones Blueprint
      </h2>
      <p class="text-xs sm:text-sm text-navy-700">
        Review the five core functional zones that residence hall rooms require for organized living:
      </p>

      <DormZoneDiagram />
    </section>

    <!-- Visual Callout: Bedding Rule -->
    <VisualCallout type="tip" title="Mattress Topper Selection: 2-Inch vs. 3-Inch Foam">
      <p>
        University dorm mattresses are firm institutional vinyl-covered foam. A <strong>2-inch topper</strong> adds basic cushioning; a <strong>3-inch high-density topper</strong> offers deeper pressure relief. Confirm your bed dimensions (most commonly Twin XL, but check specific hall specifications) before ordering.
      </p>
    </VisualCallout>

    <!-- Visual Callout: Electrical Safety Rule -->
    <VisualCallout type="safety" title="Power Strip &amp; Surge Protection Requirements">
      <p>
        Wall outlet placement and accessibility vary by building age. Use only a <strong>UL Listed (or ETL Listed) power strip or surge protector with a built-in on/off circuit switch</strong>. Plug it directly into the wall outlet; never daisy-chain power strips or use ungrounded household extension cords.
      </p>
    </VisualCallout>

    <!-- Related Deep-Dive Blueprints -->
    <section class="pt-6 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-bold text-brand-blue">
      <a href="/community-bathroom-college-essentials/" class="p-4 bg-brand-mint-50/60 rounded-2xl border border-brand-mint-100 hover:bg-brand-mint-50 flex items-center justify-between text-brand-mint-900 transition-colors">
        <span>🚿 Community Bathroom Transit &amp; Dry/Wet Routine</span>
        <span>→</span>
      </a>
      <a href="/small-dorm-room-storage-ideas/" class="p-4 bg-purple-50/60 rounded-2xl border border-purple-100 hover:bg-purple-50 flex items-center justify-between text-purple-900 transition-colors">
        <span>📐 Small Dorm Storage Measurement Planner</span>
        <span>→</span>
      </a>
    </section>
  </div>
</GuideLayout>
