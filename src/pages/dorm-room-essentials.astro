---
import GuideLayout from '../layouts/GuideLayout.astro';
import DormZoneDiagram from '../components/DormZoneDiagram.astro';
import VisualCallout from '../components/VisualCallout.astro';

const guide = {
  title: 'Dorm Room Essentials Organized by Real Daily Need',
  description: 'A realistic, practical room setup guide focusing on sleep hygiene, study ergonomics, and functional storage rather than aesthetic clutter.',
  category: 'Essentials Guide',
  categoryUrl: '/dorm-room-essentials/',
  lastUpdated: '2026-08-17',
  readingTimeMinutes: 9,
  currentSlug: 'dorm-room-essentials',
};

const faqs = [
  {
    question: 'Why is a mattress encasement protector necessary in dorms?',
    answer: 'Dorm mattresses have been used by multiple students over many years. A full zippered waterproof encasement creates a sealed physical barrier against allergens, dust mites, and stains.',
  },
  {
    question: 'How do I optimize storage under a lofted or unlofted dorm bed?',
    answer: 'Standard dorm beds have 10 to 14 inches of clearance, while lofted or junior-lofted frames offer 28 to 36 inches. Measure clearance during move-in before purchasing rigid plastic drawers; low-profile zippered under-bed bags accommodate variable heights easily.',
  },
];
---

<GuideLayout {...guide} faqs={faqs}>
  <div class="space-y-10 text-base leading-relaxed">
    <!-- Intro block -->
    <div class="p-6 bg-brand-mint-50 border-2 border-brand-mint-200 rounded-3xl shadow-soft">
      <h2 class="text-lg font-black text-emerald-950 mb-2">
        Why Most "Dorm Essentials" Lists Fail Students
      </h2>
      <p class="text-xs sm:text-sm text-navy-700 leading-relaxed">
        Typical retail blogs publish bloated 150-item lists packed with novelty gadgets that end up in campus dumpsters by December. Our guide prioritizes items that solve five non-negotiable physical constraints: <strong>mattress hardness, communal bathroom hygiene, electrical outlet scarcity, tight closet space, and study noise</strong>.
      </p>
    </div>

    <!-- 5 Functional Dorm Zones Blueprint -->
    <section class="space-y-6">
      <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">
        The 5 Functional Dorm Zones Blueprint
      </h2>
      <p class="text-xs sm:text-sm text-navy-700">
        Review the five core functional zones that every standard double dorm room requires for productive living:
      </p>

      <DormZoneDiagram />
    </section>

    <!-- Visual Callout: Bedding Rule -->
    <VisualCallout type="tip" title="Mattress Topper Selection: 2-Inch vs. 3-Inch Foam">
      <p>
        University dorm mattresses are institutional-grade, waterproof vinyl slabs designed for durability, not spinal support. A <strong>2-inch topper</strong> provides adequate cushion for back sleepers; a <strong>3-inch high-density topper</strong> is recommended for side sleepers to relieve shoulder and hip pressure points.
      </p>
    </VisualCallout>

    <!-- Visual Callout: Electrical Safety Rule -->
    <VisualCallout type="safety" title="Power Strip &amp; Surge Protection Requirements">
      <p>
        Most residence hall rooms offer only 2 or 4 wall outlets, often positioned behind the bed or heavy desk. Never use ungrounded household extension cords. Purchase a <strong>UL-listed 14-gauge surge protector with a 10–12 foot cord</strong> and built-in circuit breaker reset switch.
      </p>
    </VisualCallout>
  </div>
</GuideLayout>
