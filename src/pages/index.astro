---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import HeroVisual from '../components/HeroVisual.astro';
import StepJourney from '../components/StepJourney.astro';
import CategoryTile from '../components/CategoryTile.astro';
import BudgetComparison from '../components/BudgetComparison.astro';
import { EDITORIAL_GUIDES } from '../data/guides';
import { CHECKLIST_CATEGORIES } from '../data/checklist';

// Google Search Console verified: 2026-08-17
const featuredGuides = EDITORIAL_GUIDES.filter((g) => g.featured);
const recentGuides = [...EDITORIAL_GUIDES].sort(
  (a, b) => new Date(b.lastUpdated).getTime() - new Date(a.lastUpdated).getTime()
).slice(0, 5);

const trustPoints = [
  {
    icon: '📋',
    title: '46-Item Master Checklist',
    description: '10 practical categories with browser memory saving & one-click print.',
    badge: 'Interactive',
    color: 'bg-brand-blue-50 text-brand-blue-700 border-brand-blue-200',
  },
  {
    icon: '💵',
    title: 'Budget Setups from $300',
    description: 'Realistic $300, $500, and $1,000 blueprints for dorm setups.',
    badge: 'Transparent',
    color: 'bg-brand-mint-50 text-brand-mint-700 border-brand-mint-200',
  },
  {
    icon: '⚡',
    title: 'Campus Fire-Code Audited',
    description: 'UL wattage caps and strictly banned items highlighted to save money.',
    badge: 'Safety First',
    color: 'bg-brand-coral-50 text-brand-coral-700 border-brand-coral-200',
  },
  {
    icon: '🚫',
    title: 'Zero Sponsored Rankings',
    description: 'No affiliate fluff or luxury showroom clutter. 100% student-focused.',
    badge: 'Honest Prep',
    color: 'bg-brand-yellow-50 text-amber-800 border-amber-200',
  },
];
---

<BaseLayout
  title="DormReady | Practical College Dorm Checklists, Packing & Tech Guides"
  description="Bright, optimistic, and practical college dorm planning for U.S. freshmen and parents. Master 46-item interactive checklist, verified student discounts, and realistic $300-$1000 budget plans."
>
  <!-- Hero Section: Desktop Split Layout / Mobile Linear Sequence -->
  <section class="relative bg-gradient-to-b from-brand-blue-50/60 via-white to-white border-b border-slate-200 pt-8 pb-14 lg:pt-16 lg:pb-24 overflow-hidden">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Column: Flex ordering for mobile (1. Badge, 2. H1, 3. Illustration, 4. Paragraph, 5. CTAs, 6. Budget link) -->
        <div class="lg:col-span-7 flex flex-col space-y-4 sm:space-y-6">
          <!-- 1. Edition Badge -->
          <div class="order-1 self-start inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-white text-brand-blue-700 border border-brand-blue-200 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-coral animate-pulse"></span>
            <span>Fall 2026 Freshman Move-in Edition</span>
          </div>

          <!-- 2. H1 Headline -->
          <h1 class="order-2 text-3xl sm:text-5xl lg:text-6xl font-black text-brand-navy tracking-tight leading-[1.1]">
            Bright, practical dorm prep <span class="text-brand-blue">without the fluff</span> or wasted money.
          </h1>

          <!-- 3. Mobile Hero Illustration (Order 3 on mobile < lg, hidden on desktop lg:) -->
          <div class="order-3 lg:hidden my-2">
            <HeroVisual />
          </div>

          <!-- 4. Supporting Paragraph -->
          <p class="order-4 text-sm sm:text-base lg:text-lg text-navy-700 leading-relaxed font-sans max-w-2xl">
            The honest guide for U.S. college freshmen and parents. No 50-item luxury wishlists—just realistic Twin XL bedding, fire-code safety rules, roommate coordination strategies, and verified student discounts.
          </p>

          <!-- 5. Primary & Secondary CTAs -->
          <div class="order-5 flex flex-wrap items-center gap-3 pt-1">
            <a
              href="/college-dorm-checklist/"
              class="inline-flex items-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 rounded-2xl bg-brand-blue text-white font-black text-sm sm:text-base hover:bg-brand-blue-600 transition-all shadow-md hover:shadow-glow-blue hover:-translate-y-0.5"
            >
              <span>Open 46-Item Checklist</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <a
              href="/college-packing-list/"
              class="inline-flex items-center gap-2 px-4 sm:px-5 py-3.5 sm:py-4 rounded-2xl bg-white border-2 border-slate-200 text-brand-navy font-bold text-sm sm:text-base hover:border-brand-coral hover:text-brand-coral hover:bg-brand-coral-50/50 transition-all shadow-sm"
            >
              <span>Packing Strategy</span>
            </a>
          </div>

          <!-- 6. Budget Plans Link -->
          <div class="order-6 pt-0.5">
            <a
              href="/budget/"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-navy-700 hover:text-brand-blue hover:underline"
            >
              <span>Explore Budget Blueprints ($300 / $500 / $1,000) →</span>
            </a>
          </div>
        </div>

        <!-- Hero Right Column (Desktop Only lg:) -->
        <div class="hidden lg:block lg:col-span-5">
          <HeroVisual />
        </div>
      </div>
    </div>
  </section>

  <!-- Compact Value & Trust Strip -->
  <section class="py-8 bg-white border-b border-slate-200">
    <div class="container-custom">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {trustPoints.map((tp) => (
          <div class={`flex items-start gap-3.5 p-4 rounded-2xl border ${tp.color} bg-white shadow-soft transition-transform hover:-translate-y-0.5`}>
            <span class="text-2xl shrink-0 select-none" aria-hidden="true">{tp.icon}</span>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-xs font-black text-brand-navy">{tp.title}</h3>
              </div>
              <p class="text-[11px] text-navy-600 mt-0.5 leading-snug">
                {tp.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4-Step Freshmen Journey Section -->
  <section class="py-14 sm:py-20 bg-brand-blue-50/30 border-b border-slate-200">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
        <div>
          <span class="badge-blue mb-2">Move-in Roadmap</span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-brand-navy">
            The 4-Step Freshman Gameplan
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-navy-600 max-w-md">
          A clear, step-by-step order of operations to prevent impulse spending, duplicate appliances, and campus move-in chaos.
        </p>
      </div>

      <StepJourney />
    </div>
  </section>

  <!-- Key Categories Grid with Pastel Tiles -->
  <section class="py-14 sm:py-20 bg-white border-b border-slate-200">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
        <span class="badge-coral">Dorm Blueprint</span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-brand-navy">
          Explore by Room Category
        </h2>
        <p class="text-xs sm:text-sm text-navy-600">
          Tailored checklists for shared college residence hall rooms.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {CHECKLIST_CATEGORIES.map((category) => (
          <CategoryTile category={category} />
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Editorial Guides with 16:9 Thumbnails -->
  <section class="py-14 sm:py-20 bg-brand-coral-50/20 border-b border-slate-200">
    <div class="container-custom">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div>
          <span class="badge-coral mb-2">Deep Dives</span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-brand-navy">
            Featured Preparation Guides
          </h2>
        </div>
        <a
          href="/guides/"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-blue hover:text-brand-blue-700 hover:underline"
        >
          <span>View All {EDITORIAL_GUIDES.length} Guides &amp; Blueprints</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredGuides.map((guide) => (
          <GuideCard guide={guide} />
        ))}
      </div>
    </div>
  </section>

  <!-- Complete Budget Setups: Side-by-Side Comparison -->
  <section class="py-14 sm:py-20 bg-white border-b border-slate-200">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
        <span class="badge-mint">Smart Spending</span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-brand-navy">
          Compare Setups by Budget
        </h2>
        <p class="text-xs sm:text-sm text-navy-600">
          Realistic caps from basic sleep comfort to all-inclusive setups. Pick what fits your budget.
        </p>
      </div>

      <BudgetComparison />
    </div>
  </section>

  <!-- Illustrated Move-in Bulletin Coming Soon Card -->
  <section class="py-14 sm:py-18 bg-brand-yellow-50/50 border-b border-slate-200">
    <div class="container-custom max-w-3xl">
      <div class="bg-white border-2 border-brand-yellow-200 rounded-3xl p-8 sm:p-10 text-center shadow-soft space-y-4">
        <div class="w-12 h-12 mx-auto rounded-2xl bg-brand-yellow-100 flex items-center justify-center text-2xl shadow-sm">
          📬
        </div>
        <span class="badge-yellow">Editorial Announcement</span>
        <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">
          Printable Move-in Bulletin Coming Soon
        </h2>
        <p class="text-xs sm:text-sm text-navy-700 max-w-xl mx-auto leading-relaxed">
          Our editorial team is finalizing a downloadable 1-page printable arrival sheet with car-packing order templates and dorm move-in day schedules. Check back before August arrival!
        </p>
        <div class="pt-2">
          <a
            href="/college-dorm-checklist/"
            class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-brand-navy text-white text-xs font-bold hover:bg-navy-800 transition-colors shadow-sm"
          >
            <span>Use the Interactive Checklist in the Meantime →</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Recently Updated Editorial Content: Compact Text-based Update List (No Thumbnail Repetition) -->
  <section class="py-14 sm:py-20 bg-white">
    <div class="container-custom">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <span class="badge-blue mb-1">Audit Trail</span>
          <h2 class="text-xl sm:text-2xl font-black text-brand-navy">Recently Updated Editorial Content</h2>
        </div>
        <a href="/editorial-policy/" class="text-xs font-bold text-navy-600 hover:text-brand-blue">
          Editorial &amp; Fact-Checking Process →
        </a>
      </div>

      <div class="divide-y divide-slate-200 border-y border-slate-200 bg-white">
        {recentGuides.map((guide) => (
          <div class="py-4 sm:py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 group hover:bg-slate-50/60 px-2 sm:px-3 rounded-xl transition-colors">
            <div class="space-y-1">
              <div class="flex items-center gap-2 text-xs">
                <span class="font-bold text-brand-blue">{guide.categoryLabel}</span>
                <span class="text-slate-300">•</span>
                <span class="text-navy-500">{guide.readingTimeMinutes} min read</span>
                <span class="text-slate-300">•</span>
                <span class="text-navy-500">Updated <time datetime={guide.lastUpdated}>{guide.lastUpdated}</time></span>
              </div>
              <a href={guide.href} class="block font-black text-brand-navy text-sm sm:text-base group-hover:text-brand-blue transition-colors">
                {guide.title}
              </a>
              <p class="text-xs text-navy-600 line-clamp-1 max-w-3xl">
                {guide.description}
              </p>
            </div>
            <a
              href={guide.href}
              class="shrink-0 text-xs font-bold text-brand-blue group-hover:translate-x-1 transition-all inline-flex items-center gap-1 self-start sm:self-center"
            >
              <span>Read Guide</span>
              <span>→</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
