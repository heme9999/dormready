---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_CONFIG } from '../data/site';

const breadcrumbs = [
  { name: 'Privacy Policy', url: '/privacy/' },
];
---

<BaseLayout
  title="Privacy Policy | DormReady"
  description="DormReady Privacy Policy. Explains local storage usage, analytics, and data protection practices."
  breadcrumbs={breadcrumbs}
>
  <div class="bg-gradient-to-b from-brand-blue-50/60 via-brand-blue-50/30 to-white border-b border-slate-200 py-10 sm:py-14">
    <div class="container-custom max-w-4xl">
      <Breadcrumbs items={breadcrumbs} />

      <span class="mt-4 badge-blue">
        Starter Policy — Development Notice
      </span>

      <h1 class="mt-4 text-3xl sm:text-5xl font-black text-brand-navy leading-tight">
        Privacy Policy
      </h1>

      <p class="mt-4 text-base sm:text-lg text-navy-700 leading-relaxed font-sans">
        Last updated: August 17, 2026. This document outlines how DormReady collects, uses, and safeguards information when you visit our website.
      </p>
    </div>
  </div>

  <div class="container-custom max-w-4xl py-10 lg:py-14 space-y-8 text-xs sm:text-sm leading-relaxed text-navy-800">
    <div class="p-5 bg-brand-yellow-50 border-2 border-brand-yellow-200 rounded-2xl text-xs sm:text-sm text-amber-950 font-medium shadow-soft">
      <strong>Legal Notice:</strong> This document is a foundational starter policy template provided for development and preview purposes. It must undergo formal review by qualified legal counsel prior to full commercial operation.
    </div>

    <section class="space-y-3">
      <h2 class="text-xl font-black text-brand-navy">1. Information We Process</h2>
      <p>
        <strong>Local Browser Storage:</strong> Our interactive dorm checklist saves your checked items exclusively within your browser's <code>localStorage</code>. This data never leaves your device and is not transmitted to our servers.
      </p>
      <p>
        <strong>Automated Log Data:</strong> Standard server hosting infrastructure automatically collects standard server logs (IP address, browser type, referral URL, and request timestamp) for security and performance monitoring.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-black text-brand-navy">2. Cookies and Tracking Technologies</h2>
      <p>
        DormReady uses minimal essential static assets to maintain site performance. We do not operate tracking cookies or user fingerprinting scripts on our static pages.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-black text-brand-navy">3. Third-Party Links &amp; Outbound Merchants</h2>
      <p>
        Our site contains links to third-party merchant and educational websites (e.g., Apple Education, GitHub Education, Spotify, university housing portals). We do not control the privacy practices of external websites.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-black text-brand-navy">4. Contact &amp; Questions</h2>
      <p>
        For privacy-related inquiries or policy feedback, please open an issue via our <a href={SITE_CONFIG.githubRepoUrl} target="_blank" rel="noopener noreferrer" class="underline font-bold text-brand-blue">GitHub Repository</a>.
      </p>
    </section>
  </div>
</BaseLayout>
