---
import GuideLayout from '../../layouts/GuideLayout.astro';
import VisualCallout from '../../components/VisualCallout.astro';

const guide = {
  title: 'The Under $300 Budget Dorm Setup: Survival Essentials on a Strict Budget',
  description: 'How to get genuine sleep comfort, basic hygiene, and reliable power while spending under $300 total for the entire semester.',
  category: 'Budget Guide',
  categoryUrl: '/budget/',
  lastUpdated: '2026-08-17',
  readingTimeMinutes: 7,
  currentSlug: 'under-300-dorm-setup',
};

const items = [
  { category: 'Bedding & Sleep', name: 'High-Density 2" Memory Foam Topper (Twin XL)', cost: '$45 - $60', why: 'Eliminates back pain from hard vinyl institutional mattresses.' },
  { category: 'Bedding & Sleep', name: 'Waterproof Zippered Mattress Protector', cost: '$18 - $25', why: 'Essential hygiene barrier for multi-year dorm beds.' },
  { category: 'Bedding & Sleep', name: 'Twin XL Microfiber/Cotton Sheet Sets (2-Pack)', cost: '$25 - $35', why: 'Allows weekly laundry rotation without sleeping on bare mattress.' },
  { category: 'Bedding & Sleep', name: 'Bed Pillow with Washable Protector', cost: '$15 - $20', why: 'Basic neck support with washable hygiene cover.' },
  { category: 'Bedding & Sleep', name: 'Microfiber Comforter / Fleece Blanket', cost: '$25 - $35', why: 'Lightweight warmth for drafty dorm rooms.' },
  { category: 'Bathroom & Hygiene', name: 'Quick-Drying Mesh Shower Caddy', cost: '$10 - $14', why: 'Drains water instantly and avoids mold buildup.' },
  { category: 'Bathroom & Hygiene', name: 'Textured Rubber Shower Slides', cost: '$10 - $15', why: 'Mandatory protection against floor fungi.' },
  { category: 'Bathroom & Hygiene', name: 'Quick-Dry Bath Towels (2-Pack)', cost: '$16 - $22', why: 'Waffle or Turkish weave dries in tight spaces.' },
  { category: 'Laundry', name: 'Backpack Laundry Bag with Drawstring', cost: '$12 - $16', why: 'Easy transport down basement stairs.' },
  { category: 'Power & Tech', name: 'UL-Listed Surge Protector (8ft Cord)', cost: '$15 - $20', why: 'Residence-life approved power distribution.' },
  { category: 'Power & Tech', name: 'Extra-Long 10ft Braided Phone Cable', cost: '$8 - $12', why: 'Reaches lofted beds from awkward wall outlets.' },
  { category: 'Storage & Health', name: 'Slim Velvet Hangers (30-Pack)', cost: '$14 - $18', why: 'Doubles tight closet capacity.' },
  { category: 'Storage & Health', name: 'Basic First Aid Kit & OTC Meds', cost: '$15 - $20', why: 'Ibuprofen, thermometer, bandages.' },
];
---

<GuideLayout {...guide}>
  <div class="space-y-8 text-base leading-relaxed">
    <!-- Intro box -->
    <div class="p-6 bg-brand-mint-50 border-2 border-brand-mint-200 rounded-3xl shadow-soft">
      <h2 class="text-lg font-black text-emerald-950 mb-2">The $300 Philosophy: Focus on Physical Biology</h2>
      <p class="text-xs sm:text-sm text-navy-700 leading-relaxed">
        When your budget is capped at $300, <strong>80% of your dollars must go toward sleep, hygiene, and fire safety</strong>. Cut all aesthetic tapestries, decorative throw pillows, and novelty appliances. Every dollar below is allocated to items that directly impact your health and academic stamina.
      </p>
    </div>

    <!-- Line Item Breakdown Table -->
    <section class="space-y-4">
      <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">Line-Item Spending Breakdown (Target Total: ~$265)</h2>
      <div class="overflow-x-auto my-4 rounded-2xl border-2 border-slate-200 shadow-soft">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-100 text-brand-navy font-black">
            <tr>
              <th class="p-3.5 border-b border-slate-200">Category</th>
              <th class="p-3.5 border-b border-slate-200">Item</th>
              <th class="p-3.5 border-b border-slate-200">Estimated Cost</th>
              <th class="p-3.5 border-b border-slate-200">Why It's Non-Negotiable</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            {items.map((item) => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-3.5 font-black text-brand-navy text-xs">{item.category}</td>
                <td class="p-3.5 font-semibold text-navy-900">{item.name}</td>
                <td class="p-3.5 text-brand-mint-700 font-black whitespace-nowrap">{item.cost}</td>
                <td class="p-3.5 text-navy-600 text-xs">{item.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Visual Callout -->
    <VisualCallout type="tip" title="Where to Cut Costs Without Risking Comfort">
      <p>
        Never skimp on the mattress topper or surge protector. Instead, save $50+ by packing hangers and bath towels from home, and buying laundry detergent at local discount grocery stores rather than campus convenience stores.
      </p>
    </VisualCallout>
  </div>
</GuideLayout>
