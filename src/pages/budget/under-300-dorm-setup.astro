---
import GuideLayout from '../../layouts/GuideLayout.astro';
import VisualCallout from '../../components/VisualCallout.astro';
import PolicyNotice from '../../components/PolicyNotice.astro';

const guide = {
  title: 'The Under $300 Budget Dorm Setup: Survival Essentials on a Strict Budget',
  description: 'How to prioritize sleep hygiene, basic bathroom gear, and verified power safety while keeping total initial spending under $300.',
  category: 'Budget Guide',
  categoryUrl: '/budget/',
  lastUpdated: '2026-08-17',
  readingTimeMinutes: 7,
  currentSlug: 'under-300-dorm-setup',
};

const items = [
  { category: 'Bedding & Sleep', name: 'High-Density 2" Foam Topper (Twin XL)', cost: '$45 - $60', why: 'Adds cushioning over firm institutional vinyl mattresses; comfort preferences vary.' },
  { category: 'Bedding & Sleep', name: 'Waterproof Zippered Mattress Protector', cost: '$18 - $25', why: 'Essential hygiene barrier for multi-year dorm beds.' },
  { category: 'Bedding & Sleep', name: 'Twin XL Microfiber/Cotton Sheet Sets (2-Pack)', cost: '$25 - $35', why: 'Allows weekly laundry rotation without sleeping on a bare mattress.' },
  { category: 'Bedding & Sleep', name: 'Bed Pillow with Washable Protector', cost: '$15 - $20', why: 'Basic neck support with a washable hygiene cover.' },
  { category: 'Bedding & Sleep', name: 'Microfiber Comforter / Fleece Blanket', cost: '$25 - $35', why: 'Lightweight warmth for drafty dorm rooms.' },
  { category: 'Bathroom & Hygiene', name: 'Quick-Drying Mesh Shower Caddy', cost: '$10 - $14', why: 'Drains water quickly to minimize mildew buildup.' },
  { category: 'Bathroom & Hygiene', name: 'Textured Rubber Shower Slides', cost: '$10 - $15', why: 'Hygiene barrier against shared bathroom floor surfaces.' },
  { category: 'Bathroom & Hygiene', name: 'Quick-Dry Bath Towels (2-Pack)', cost: '$16 - $22', why: 'Lightweight weave dries faster in low-airflow rooms.' },
  { category: 'Laundry', name: 'Backpack Laundry Bag with Drawstring', cost: '$12 - $16', why: 'Easy transport down basement stairs.' },
  { category: 'Power & Tech', name: 'UL-Listed Surge Protector (6-8ft Cord)', cost: '$15 - $20', why: 'Residence-hall approved power distribution with built-in circuit breaker.' },
  { category: 'Power & Tech', name: 'Extra-Long 10ft Braided Phone Cable', cost: '$8 - $12', why: 'Reaches lofted beds from wall outlets.' },
  { category: 'Storage & Health', name: 'Slim Velvet Hangers (30-Pack)', cost: '$14 - $18', why: 'Maximizes tight closet rod space.' },
  { category: 'Storage & Health', name: 'Basic First Aid Kit & OTC Meds', cost: '$15 - $20', why: 'Ibuprofen, thermometer, bandages.' },
];
---

<GuideLayout {...guide}>
  <div class="space-y-8 text-base leading-relaxed">
    <PolicyNotice topic="budget and appliance rules" />

    <!-- Intro box -->
    <div class="p-6 bg-brand-mint-50 border-2 border-brand-mint-200 rounded-3xl shadow-soft">
      <h2 class="text-lg font-black text-emerald-950 mb-2">The $300 Priority Framework: Core Essentials First</h2>
      <p class="text-xs sm:text-sm text-navy-700 leading-relaxed">
        On a strict $300 budget, we recommend prioritizing your spending on <strong>sleep comfort, hygiene, and fire safety</strong>. Postpone decorative accents, novelty lighting, and small appliances until after move-in when you've evaluated your room layout and actual daily needs.
      </p>
    </div>

    <!-- Line Item Breakdown Table -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">Line-Item Spending Breakdown (Target Total: ~$265)</h2>
        <span class="text-xs text-navy-500 font-medium">Estimated price ranges checked Aug 17, 2026 across major national retailers</span>
      </div>
      <div class="overflow-x-auto my-4 rounded-2xl border-2 border-slate-200 shadow-soft">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-100 text-brand-navy font-black">
            <tr>
              <th class="p-3.5 border-b border-slate-200">Category</th>
              <th class="p-3.5 border-b border-slate-200">Item</th>
              <th class="p-3.5 border-b border-slate-200">Estimated Cost</th>
              <th class="p-3.5 border-b border-slate-200">Practical Purpose</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            {items.map((item) => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-3.5 font-black text-brand-navy text-xs">{item.category}</td>
                <td class="p-3.5 font-semibold text-navy-900">{item.name}</td>
                <td class="p-3.5 text-brand-mint-700 font-black whitespace-nowrap">{item.cost}</td>
                <td class="p-3.5 text-navy-600 text-xs">{item.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Visual Callout -->
    <VisualCallout type="tip" title="Where to Cut Costs Without Compromising Safety">
      <p>
        Never skimp on the mattress protector or a UL-Listed surge protector. Instead, save $50+ by bringing hangers, pillows, and towels from home, and purchasing laundry detergent at local grocery stores rather than campus convenience markets.
      </p>
    </VisualCallout>
  </div>
</GuideLayout>
