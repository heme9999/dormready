---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import BudgetComparison from '../../components/BudgetComparison.astro';

const breadcrumbs = [
  { name: 'Budget Setups', url: '/budget/' },
];
---

<BaseLayout
  title="Dorm Room Setups by Budget: $300, $500 & $1,000 Guides"
  description="Practical, realistic dorm room equipment breakdowns organized by budget tier. Line-item spending plans for $300, $500, and $1,000 total outlays."
  breadcrumbs={breadcrumbs}
>
  <div class="bg-gradient-to-b from-brand-yellow-50 via-brand-yellow-50/50 to-white border-b border-slate-200 py-10 sm:py-14">
    <div class="container-custom">
      <Breadcrumbs items={breadcrumbs} />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mt-6">
        <div class="lg:col-span-8 space-y-4">
          <div class="flex flex-wrap items-center gap-2.5 text-xs font-bold text-navy-600">
            <span class="badge-yellow">
              Spending Blueprints
            </span>
            <span>•</span>
            <span class="text-brand-navy">3 Transparent Tiers</span>
            <span>•</span>
            <span>Last audited: <time datetime="2026-08-17" class="text-brand-blue">August 17, 2026</time></span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-brand-navy leading-tight">
            Dorm Room Budget Blueprints
          </h1>

          <p class="text-base sm:text-lg text-navy-700 max-w-2xl leading-relaxed">
            You don't need a $2,000 budget to create a comfortable, organized, and hygienic dorm space. Choose the spending tier that matches your family's plan for comprehensive line-item breakdowns.
          </p>
        </div>

        <div class="lg:col-span-4 hidden lg:block">
          <img
            src="/images/guides/budget-planner.svg"
            alt="Dorm budget blueprints comparison visual"
            width="640"
            height="360"
            class="w-full h-auto rounded-3xl border-2 border-brand-yellow-200 shadow-soft"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="container-custom py-8 sm:py-12 space-y-12">
    <AffiliateDisclosure compact={true} />

    <!-- Side-by-Side Comparison Matrix -->
    <section class="space-y-6">
      <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">
        Side-by-Side Tier Comparison
      </h2>
      <BudgetComparison />
    </section>

    <!-- Guiding Philosophy -->
    <div class="p-8 bg-brand-blue-50/50 border-2 border-brand-blue-100 rounded-3xl space-y-4 max-w-5xl shadow-soft">
      <h3 class="text-xl font-black text-brand-navy">
        The DormReady 60/30/10 Budget Allocation Rule
      </h3>
      <p class="text-xs sm:text-sm text-navy-700 leading-relaxed">
        When allocating funds for college living, distribute your budget according to real daily utility rather than aesthetic impulse buys:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm pt-2">
        <div class="p-5 bg-white rounded-2xl border-2 border-brand-blue-100 shadow-sm">
          <span class="font-black text-brand-blue text-base block mb-1">60% Sleep &amp; Hygiene</span>
          <p class="text-navy-600 text-xs">High-density mattress topper, zippered encasement, 2 sheet sets, shower shoes, and medical kit.</p>
        </div>
        <div class="p-5 bg-white rounded-2xl border-2 border-brand-coral-100 shadow-sm">
          <span class="font-black text-brand-coral text-base block mb-1">30% Study &amp; Power</span>
          <p class="text-navy-600 text-xs">UL-listed surge protectors, 10ft cables, task lighting, and ergonomic seating cushions.</p>
        </div>
        <div class="p-5 bg-white rounded-2xl border-2 border-brand-mint-100 shadow-sm">
          <span class="font-black text-brand-mint text-base block mb-1">10% Storage &amp; Decor</span>
          <p class="text-navy-600 text-xs">Under-bed clear totes, over-door hooks, compact floor rugs, and hanging shoe organizers.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
