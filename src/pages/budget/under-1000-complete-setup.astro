---
import GuideLayout from '../../layouts/GuideLayout.astro';
import VisualCallout from '../../components/VisualCallout.astro';
import PolicyNotice from '../../components/PolicyNotice.astro';

const guide = {
  title: 'The Under $1,000 Complete Dorm Setup: All-Inclusive Comfort & Workstation',
  description: 'A comprehensive dorm room investment covering shared mini-fridge/microwave contributions, premium noise isolation, active ergonomics, and year-round climate prep.',
  category: 'Budget Guide',
  categoryUrl: '/budget/',
  lastUpdated: '2026-08-17',
  readingTimeMinutes: 9,
  currentSlug: 'under-1000-complete-setup',
};

const items = [
  { category: 'Bedding Suite', name: '3" High-Density Gel Foam Topper, 2 Cotton Sheet Sets & Duvet Insert', cost: '$180 - $220', why: 'Supportive sleep comfort and washable temperature regulation.' },
  { category: 'Shared Appliances', name: '50% Contribution to Shared Mini-Fridge / Microwave Combo', cost: '$120 - $160', why: 'Fresh grocery storage, meal prep, and cold drink access (if permitted and not already supplied).' },
  { category: 'Focus & Study Audio', name: 'Active Noise-Cancelling (ANC) Over-Ear Headphones', cost: '$130 - $180', why: 'Helps maintain focus in busy floor lounges and study rooms.' },
  { category: 'Desk & Workstation', name: 'Ergonomic Seat Cushion, Laptop Stand & LED Task Light', cost: '$70 - $95', why: 'Supports posture during extended computer study sessions.' },
  { category: 'Power & Charging', name: '100W GaN Charging Station + UL-Listed Surge Strip', cost: '$65 - $85', why: 'Safely powers laptops and mobile devices with built-in circuit protection.' },
  { category: 'Climate & Air', name: 'Compact HEPA Air Purifier & Clip-On Bed Fan', cost: '$60 - $85', why: 'Aids air filtration and provides focused airflow in halls without individual A/C.' },
  { category: 'Hygiene & Laundry', name: 'Premium Quick-Dry Towels, Mesh Caddy, Drying Rack & Hamper', cost: '$75 - $95', why: 'Complete durable laundry and communal bathroom system.' },
  { category: 'Storage & Floor', name: 'Small Area Rug, Under-Bed Storage Totes & Over-Door Hooks', cost: '$80 - $110', why: 'Adds floor comfort and organizes storage; measure clearance after arrival.' },
];
---

<GuideLayout {...guide}>
  <div class="space-y-8 text-base leading-relaxed">
    <PolicyNotice topic="appliances and electronics" />

    <div class="p-6 bg-brand-coral-50 border-2 border-brand-coral-200 rounded-3xl shadow-soft">
      <h2 class="text-lg font-black text-rose-950 mb-2">The $1,000 Setup: Complete Ergonomics and Workstation Prep</h2>
      <p class="text-xs sm:text-sm text-navy-700 leading-relaxed">
        With a larger budget, you can invest in durable study ergonomics, active noise cancellation, and room climate accessories. Items in this tier are selected for multi-year durability so they transition smoothly to sophomore and off-campus housing.
      </p>
    </div>

    <!-- Line item table -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">Line-Item Spending Breakdown (Target Total: ~$780–$930)</h2>
        <span class="text-xs text-navy-500 font-medium">Estimated price ranges checked Aug 17, 2026 across major national retailers</span>
      </div>
      <div class="overflow-x-auto my-4 rounded-2xl border-2 border-slate-200 shadow-soft">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-100 text-brand-navy font-black">
            <tr>
              <th class="p-3.5 border-b border-slate-200">Category</th>
              <th class="p-3.5 border-b border-slate-200">Item</th>
              <th class="p-3.5 border-b border-slate-200">Estimated Cost</th>
              <th class="p-3.5 border-b border-slate-200">Practical Purpose</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            {items.map((item) => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-3.5 font-black text-brand-navy text-xs">{item.category}</td>
                <td class="p-3.5 font-semibold text-navy-900">{item.name}</td>
                <td class="p-3.5 text-brand-coral-700 font-black whitespace-nowrap">{item.cost}</td>
                <td class="p-3.5 text-navy-600 text-xs">{item.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Visual Callout -->
    <VisualCallout type="warning" title="Confirm Provided Amenities Before Purchasing Appliances">
      <p>
        Several universities (such as UT Austin in standard halls) already provide a combination microwave/refrigerator unit in every dorm room. Verify your room's furnished inventory list before buying or renting large appliances.
      </p>
    </VisualCallout>
  </div>
</GuideLayout>
