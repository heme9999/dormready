---
import GuideLayout from '../../layouts/GuideLayout.astro';

const guide = {
  title: 'The Under $1,000 Complete Dorm Setup: All-Inclusive Comfort & Workstation',
  description: 'A comprehensive dorm room investment covering shared mini-fridge/microwave contributions, premium noise isolation, active ergonomics, and year-round climate prep.',
  category: 'Budget Guide',
  categoryUrl: '/budget/',
  lastUpdated: '2026-08-09',
  readingTimeMinutes: 9,
  currentSlug: 'under-1000-complete-setup',
};

const items = [
  { category: 'Bedding Suite', name: '3" High-Density Gel Foam Topper, 2 Organic Cotton Sheet Sets & Duvet Insert', cost: '$180 - $220', why: 'Maximum sleep quality and breathable temperature regulation.' },
  { category: 'Shared Appliances', name: '50% Contribution to Shared Mini-Fridge / Microwave Combo', cost: '$120 - $160', why: 'Fresh grocery storage, meal prep, and cold drink access.' },
  { category: 'Focus & Study Audio', name: 'Active Noise-Cancelling (ANC) Over-Ear Headphones', cost: '$130 - $180', why: 'Block hallway noise, roommate gaming, and busy library chatter.' },
  { category: 'Desk & Workstation', name: 'Ergonomic Seat Cushion, Laptop Stand & LED Task Light', cost: '$70 - $95', why: 'Prevents neck and lower back strain during 6-hour essay sessions.' },
  { category: 'Power & Charging', name: '100W GaN Charging Station + 2 Heavy-Duty Surge Strips', cost: '$65 - $85', why: 'Powers multi-device setup without tripping dorm circuit breakers.' },
  { category: 'Climate & Air', name: 'Compact HEPA Air Purifier & Clip-On Bed Fan', cost: '$60 - $85', why: 'Removes dorm dust, pollen, and provides essential airflow in un-airconditioned halls.' },
  { category: 'Hygiene & Laundry', name: 'Premium Quick-Dry Towels, Mesh Caddy, Drying Rack & Hamper', cost: '$75 - $95', why: 'Complete durable laundry and communal bathroom system.' },
  { category: 'Storage & Floor', name: 'Plush 4x6 Area Rug, Under-Bed Rolling Totes & Over-Door Hooks', cost: '$80 - $110', why: 'Softens linoleum floors and maximizes tight room storage.' },
];
---

<GuideLayout {...guide}>
  <div class="space-y-8 text-base leading-relaxed">
    <div class="p-6 bg-cream-100 border border-cream-300 rounded-2xl">
      <h2 class="text-lg font-bold text-navy-900 mb-2">The $1,000 Setup: The Complete College Sanctuary</h2>
      <p class="text-sm text-navy-700 leading-relaxed">
        With a $1,000 budget, you can fully equip your residence hall room for top-tier academic productivity, high-grade sleep recovery, and healthy meal storage. Every item is selected for multi-year durability so it transitions smoothly to sophomore off-campus housing.
      </p>
    </div>

    <!-- Line item table -->
    <section class="space-y-4">
      <h2 class="text-2xl font-bold font-serif text-navy-900">Line-Item Spending Breakdown (Target Total: ~$940)</h2>
      <div class="overflow-x-auto my-4">
        <table class="w-full text-left text-xs sm:text-sm border border-cream-300 rounded-xl overflow-hidden">
          <thead class="bg-cream-200 text-navy-900 font-bold">
            <tr>
              <th class="p-3 border-b border-cream-300">Category</th>
              <th class="p-3 border-b border-cream-300">Item</th>
              <th class="p-3 border-b border-cream-300">Estimated Cost</th>
              <th class="p-3 border-b border-cream-300">Why It's Worth the Investment</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-cream-200 bg-white">
            {items.map((item) => (
              <tr>
                <td class="p-3 font-semibold text-navy-900 text-xs">{item.category}</td>
                <td class="p-3 font-medium text-navy-900">{item.name}</td>
                <td class="p-3 text-forest-800 font-bold whitespace-nowrap">{item.cost}</td>
                <td class="p-3 text-navy-600 text-xs">{item.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Deep-dive on appliances & noise cancellation -->
    <section class="space-y-4">
      <h2 class="text-2xl font-bold font-serif text-navy-900">High-Impact Investments in this Tier</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-5 bg-white border border-cream-300 rounded-xl space-y-2">
          <h3 class="font-bold text-navy-900 text-base">Active Noise-Cancelling (ANC) Headphones</h3>
          <p class="text-xs text-navy-600 leading-relaxed">
            Dormitory hallways are rarely quiet. Quality ANC headphones allow you to enter a deep state of concentration in your room even when your roommate has guests or is gaming.
          </p>
        </div>
        <div class="p-5 bg-white border border-cream-300 rounded-xl space-y-2">
          <h3 class="font-bold text-navy-900 text-base">True HEPA Air Purifier</h3>
          <p class="text-xs text-navy-600 leading-relaxed">
            Older residence halls often have decades of dust in central ventilation ducts. A compact HEPA filter dramatically cuts down on allergy symptoms and freshmen winter colds.
          </p>
        </div>
      </div>
    </section>

    <!-- Next steps CTA -->
    <div class="p-6 bg-cream-100 border border-cream-300 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h3 class="text-base font-bold text-navy-900">Check Your Total Equipment List</h3>
        <p class="text-xs text-navy-600 mt-0.5">Use our free interactive tool with local progress saving and instant print mode.</p>
      </div>
      <a
        href="/college-dorm-checklist/"
        class="px-5 py-2.5 rounded-lg bg-forest-800 text-cream-50 text-sm font-semibold hover:bg-forest-900 transition-colors shrink-0"
      >
        Open Interactive Checklist &rarr;
      </a>
    </div>
  </div>
</GuideLayout>
