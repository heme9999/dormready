---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';
import { EDITORIAL_GUIDES } from '../../data/guides';

const breadcrumbs = [
  { name: 'All Guides', url: '/guides/' },
];

const categories = [
  { key: 'all', label: 'All Guides' },
  { key: 'checklists', label: 'Checklists & Essentials' },
  { key: 'packing', label: 'Packing Strategy' },
  { key: 'budget', label: 'Budget Setups' },
  { key: 'tech', label: 'Tech & Laptops' },
  { key: 'discounts', label: 'Student Discounts' },
];
---

<BaseLayout
  title="College Preparation & Dorm Life Guides Archive | DormReady"
  description="Explore all DormReady college preparation guides, dorm checklists, packing frameworks, technology matrixes, and student discount breakdowns."
  breadcrumbs={breadcrumbs}
>
  <div class="bg-gradient-to-b from-brand-blue-50/60 via-brand-blue-50/30 to-white border-b border-slate-200 py-10 sm:py-14">
    <div class="container-custom">
      <Breadcrumbs items={breadcrumbs} />

      <span class="mt-4 badge-blue">
        Knowledge Base
      </span>

      <h1 class="mt-4 text-3xl sm:text-5xl font-black text-brand-navy leading-tight">
        Dorm Preparation Guides Archive
      </h1>

      <p class="mt-4 text-base sm:text-lg text-navy-700 max-w-3xl leading-relaxed">
        Every guide published on DormReady is independently researched and structured for practical, budget-conscious college freshmen and families.
      </p>
    </div>
  </div>

  <div class="container-custom py-8 sm:py-12">
    <!-- Category Filter Controls (Client JS) -->
    <div class="mb-8 flex flex-wrap items-center gap-2" id="category-filter-container">
      {categories.map((c) => (
        <button
          type="button"
          data-category={c.key}
          class={`filter-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all border ${
            c.key === 'all'
              ? 'bg-brand-blue text-white border-brand-blue active-filter shadow-sm'
              : 'bg-white text-navy-700 border-slate-200 hover:bg-slate-50'
          }`}
        >
          {c.label}
        </button>
      ))}
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="guides-grid">
      {EDITORIAL_GUIDES.map((guide) => (
        <div class="guide-item" data-category={guide.category}>
          <GuideCard guide={guide} />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll('.filter-tab');
  const items = document.querySelectorAll('.guide-item');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const selectedCategory = tab.getAttribute('data-category');

      tabs.forEach((t) => {
        t.classList.remove('bg-brand-blue', 'text-white', 'border-brand-blue', 'active-filter', 'shadow-sm');
        t.classList.add('bg-white', 'text-navy-700', 'border-slate-200');
      });

      tab.classList.add('bg-brand-blue', 'text-white', 'border-brand-blue', 'active-filter', 'shadow-sm');
      tab.classList.remove('bg-white', 'text-navy-700', 'border-slate-200');

      items.forEach((item) => {
        const itemCategory = item.getAttribute('data-category');
        if (selectedCategory === 'all' || itemCategory === selectedCategory) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
