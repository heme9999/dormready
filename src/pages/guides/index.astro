---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';
import { EDITORIAL_GUIDES } from '../../data/guides';

const breadcrumbs = [
  { name: 'All Guides', url: '/guides/' },
];

const categories = [
  { key: 'all', label: 'All Guides' },
  { key: 'checklists', label: 'Checklists & Essentials' },
  { key: 'packing', label: 'Packing Strategy' },
  { key: 'budget', label: 'Budget Setups' },
  { key: 'tech', label: 'Tech & Laptops' },
  { key: 'discounts', label: 'Student Discounts' },
];
---

<BaseLayout
  title="College Preparation & Dorm Life Guides Archive | DormReady"
  description="Explore all DormReady college preparation guides, dorm checklists, packing frameworks, technology matrixes, and student discount breakdowns."
  breadcrumbs={breadcrumbs}
>
  <div class="bg-cream-100 border-b border-cream-300 py-8 sm:py-12">
    <div class="container-custom">
      <Breadcrumbs items={breadcrumbs} />

      <span class="mt-4 inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-forest-50 text-forest-800 border border-forest-100">
        Knowledge Base
      </span>

      <h1 class="mt-4 text-3xl sm:text-5xl font-bold font-serif text-navy-900 leading-tight">
        Dorm Preparation Guides Archive
      </h1>

      <p class="mt-4 text-base sm:text-lg text-navy-700 max-w-3xl leading-relaxed">
        Every guide published on DormReady is independently researched and structured for practical, budget-conscious college freshmen and families.
      </p>
    </div>
  </div>

  <div class="container-custom py-8 sm:py-12">
    <!-- Category Filter Controls (Client JS) -->
    <div class="mb-8 flex flex-wrap items-center gap-2" id="category-filter-container">
      {categories.map((c) => (
        <button
          type="button"
          data-category={c.key}
          class={`filter-tab px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors border ${
            c.key === 'all'
              ? 'bg-forest-800 text-cream-50 border-forest-800 active-filter'
              : 'bg-white text-navy-700 border-cream-300 hover:bg-cream-100'
          }`}
        >
          {c.label}
        </button>
      ))}
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="guides-grid">
      {EDITORIAL_GUIDES.map((guide) => (
        <div data-guide-category={guide.category} class="guide-grid-item">
          <GuideCard guide={guide} />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('.filter-tab');
  const items = document.querySelectorAll('.guide-grid-item');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-category');

      // Update button styles
      buttons.forEach((b) => {
        b.classList.remove('bg-forest-800', 'text-cream-50', 'border-forest-800', 'active-filter');
        b.classList.add('bg-white', 'text-navy-700', 'border-cream-300');
      });
      btn.classList.add('bg-forest-800', 'text-cream-50', 'border-forest-800', 'active-filter');
      btn.classList.remove('bg-white', 'text-navy-700', 'border-cream-300');

      // Filter items
      items.forEach((item) => {
        const itemCat = item.getAttribute('data-guide-category');
        if (selected === 'all' || itemCat === selected) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
