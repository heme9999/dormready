---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import LaptopComparison from '../components/LaptopComparison';
import DecisionFlow from '../components/DecisionFlow.astro';
import VisualCallout from '../components/VisualCallout.astro';

const breadcrumbs = [
  { name: 'Guides', url: '/guides/' },
  { name: 'College Laptop Guide & Comparison', url: '/best-laptops-for-college-students/' },
];

const faqs = [
  {
    question: 'How much RAM do college students really need in 2026–2027?',
    answer: 'For a 4-year undergraduate lifecycle, 16GB of RAM is now the practical recommended minimum. Modern operating systems, web-based LMS platforms with dozens of research tabs, digital textbooks, and Zoom multitasking rapidly exceed 8GB of memory.',
  },
  {
    question: 'Can engineering students use a MacBook for college?',
    answer: 'Many engineering disciplines (Mechanical, Civil, Aerospace) require Windows-native engineering packages such as SolidWorks, AutoCAD, ANSYS, and Revit that do not run natively on Apple Silicon without complex emulation or virtual machines. Consult your specific department requirements before buying.',
  },
  {
    question: 'How do student education discounts work on college laptops?',
    answer: 'Major manufacturers (Apple, Dell, Lenovo, HP) offer education pricing verified through institutional .edu email addresses or third-party verification portals (UNiDAYS, SheerID). During summer back-to-school promotional periods, brands often offer seasonal promotional gift cards or accessory bundles.',
  },
];
---

<BaseLayout
  title="College Laptop Buying Guide & Major-by-Major Comparison Matrix"
  description="How to choose a college laptop based on your major, operating system, and budget. Filter hardware profiles with transparent testing guidelines."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  ogType="article"
  modifiedTime="2026-08-17"
>
  <div class="bg-gradient-to-b from-brand-blue-50 via-brand-blue-50/50 to-white border-b border-slate-200 py-10 sm:py-14">
    <div class="container-custom">
      <Breadcrumbs items={breadcrumbs} />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mt-6">
        <div class="lg:col-span-8 space-y-4">
          <div class="flex flex-wrap items-center gap-2.5 text-xs font-bold text-navy-600">
            <span class="badge-blue">
              Hardware Matrix
            </span>
            <span>•</span>
            <span class="text-brand-navy">Major-Specific Profiles</span>
            <span>•</span>
            <span>Last audited: <time datetime="2026-08-17" class="text-brand-blue">August 17, 2026</time></span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-brand-navy leading-tight">
            College Laptop Requirements &amp; Comparison Guide
          </h1>

          <p class="text-base sm:text-lg text-navy-700 max-w-2xl leading-relaxed">
            Hardware standards broken down by academic field, battery longevity, and operating system requirements. Use our interactive matrix to identify the right specification profile for your major.
          </p>
        </div>

        <div class="lg:col-span-4 hidden lg:block">
          <img
            src="/images/guides/laptop-desk.svg"
            alt="College student study desk with laptop and headphones"
            width="640"
            height="360"
            class="w-full h-auto rounded-3xl border-2 border-brand-blue-100 shadow-soft"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="container-custom py-8 sm:py-12">
    <AffiliateDisclosure compact={true} />

    <!-- 5-Step Visual Decision Pathway -->
    <section class="mb-12 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <span class="badge-coral mb-1">Decision Pathway</span>
          <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">How to Choose in 5 Steps</h2>
        </div>
      </div>
      <DecisionFlow />
    </section>

    <!-- Interactive Laptop Comparison Client Island -->
    <section class="space-y-6">
      <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">
        Major-by-Major Laptop Matrix
      </h2>
      <LaptopComparison client:load />
    </section>

    <!-- Static Educational Guidance & FAQ -->
    <div class="mt-16 pt-12 border-t border-slate-200 space-y-12">
      <VisualCallout type="warning" title="Engineering &amp; Architecture Major Disclaimer">
        <p>
          Always check your specific university department software syllabus before purchasing a MacBook. While Apple Silicon offers class-leading battery and thermals, programs requiring <strong>SolidWorks, Revit, ANSYS, and specialized CAD/GIS tools</strong> often mandate Windows x86 hardware.
        </p>
      </VisualCallout>

      <!-- Frequently Asked Questions -->
      <section class="max-w-4xl space-y-6">
        <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">
          College Laptop Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="p-6 bg-white border-2 border-slate-200 rounded-2xl shadow-soft">
              <h3 class="font-bold text-brand-navy text-base mb-2">{faq.question}</h3>
              <p class="text-xs sm:text-sm text-navy-700 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
