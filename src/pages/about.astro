---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'About Us', url: '/about/' },
];
---

<BaseLayout
  title="About DormReady | Mission, Standards & Research Process"
  description="Learn about the DormReady editorial mission, our target audience of college freshmen and parents, and our commitment to honest, unbloated dorm preparation guidance."
  breadcrumbs={breadcrumbs}
>
  <div class="bg-gradient-to-b from-brand-blue-50/60 via-brand-blue-50/30 to-white border-b border-slate-200 py-10 sm:py-14">
    <div class="container-custom max-w-4xl">
      <Breadcrumbs items={breadcrumbs} />

      <span class="mt-4 badge-blue">
        About DormReady
      </span>

      <h1 class="mt-4 text-3xl sm:text-5xl font-black text-brand-navy leading-tight">
        Honest, Practical Dorm Preparation
      </h1>

      <p class="mt-4 text-base sm:text-lg text-navy-700 leading-relaxed font-sans">
        DormReady was created to solve a pervasive problem: bloated, affiliate-driven college dorm checklists that pressure freshmen and families into purchasing hundreds of dollars of useless clutter.
      </p>
    </div>
  </div>

  <div class="container-custom max-w-4xl py-10 lg:py-14 space-y-12 text-xs sm:text-sm leading-relaxed text-navy-800">
    <section class="space-y-4">
      <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">Our Core Mission</h2>
      <p>
        Moving into a college residence hall represents a major life transition. Between tuition bills, housing contracts, and academic orientation, students and parents face intense decision fatigue.
      </p>
      <p>
        Our mission is to provide <strong>clarity, restraint, and practical utility</strong>. We believe the best dorm room is not the one with the most decorative gadgets, but the one that maximizes restful sleep, maintains clean communal hygiene, and supports healthy academic focus.
      </p>
    </section>

    <!-- Editorial Lifecycle Flow Diagram -->
    <section class="space-y-4">
      <h2 class="text-xl sm:text-2xl font-black text-brand-navy">Our 3-Stage Editorial Review Flow</h2>
      <p class="text-navy-600">
        Every guide and checklist on DormReady passes through our 3-stage validation pipeline:
      </p>
      <img
        src="/images/diagrams/editorial-flow.svg"
        alt="DormReady 3-stage editorial review flow: Fire Code Audit, Spatial Reality Check, and Verified Merchant Terms"
        width="680"
        height="140"
        class="w-full h-auto rounded-2xl border-2 border-brand-mint-200 shadow-soft"
      />
    </section>

    <section class="space-y-4">
      <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">Who We Build For</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 bg-white border-2 border-slate-200 rounded-2xl shadow-soft space-y-2">
          <span class="badge-blue">Audience 1</span>
          <h3 class="font-black text-brand-navy text-base">Incoming College Freshmen</h3>
          <p class="text-xs text-navy-600 leading-relaxed">
            First-time residence hall occupants seeking realistic advice on what to pack, how to coordinate with roommates, and how to navigate university fire regulations.
          </p>
        </div>
        <div class="p-6 bg-white border-2 border-slate-200 rounded-2xl shadow-soft space-y-2">
          <span class="badge-coral">Audience 2</span>
          <h3 class="font-black text-brand-navy text-base">Parents &amp; Families</h3>
          <p class="text-xs text-navy-600 leading-relaxed">
            Budget-conscious parents managing back-to-school expenses who want to avoid spending money on items their student will never use.
          </p>
        </div>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">Editorial Standards &amp; Independence</h2>
      <p>
        We strictly maintain zero sponsored product placements. Our recommendations reflect campus housing policies, practical student experiences, and the spatial realities of shared residence hall living.
      </p>
      <div class="pt-2">
        <a href="/editorial-policy/" class="inline-flex items-center gap-1 text-xs font-bold text-brand-blue hover:underline">
          <span>Read our full Editorial Policy &amp; Auditing Standards</span>
          <span>→</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
