---
import GuideLayout from '../layouts/GuideLayout.astro';
import PackingFramework from '../components/PackingFramework.astro';
import VisualCallout from '../components/VisualCallout.astro';
import PolicyNotice from '../components/PolicyNotice.astro';

const guide = {
  title: 'Strategic College Packing List: What to Bring, Buy There & Leave Behind',
  description: 'A realistic freshman packing strategy covering move-in carry-on essentials, roommate coordination rules, and the top items students consistently overpack.',
  category: 'Packing Strategy',
  categoryUrl: '/college-packing-list/',
  lastUpdated: '2026-08-17',
  readingTimeMinutes: 10,
  currentSlug: 'college-packing-list',
};

const faqs = [
  {
    question: 'How many suitcases or boxes should a college freshman bring?',
    answer: 'Aim for 2 large checked duffels or plastic storage totes plus 1 backpack for move-in day. Packing in collapsible duffels or zippered storage bags is far superior to rigid hard-shell suitcases, which consume massive closet floor space all semester.',
  },
  {
    question: 'What items should I definitely buy after arriving on campus?',
    answer: 'Bulky liquid cleaning products, dish soap, laundry detergent, paper towels, snacks, area rugs, and room trash cans are often easier to purchase at a local store near campus to save vehicle and luggage space.',
  },
];
---

<GuideLayout {...guide} faqs={faqs}>
  <div class="space-y-8 text-base leading-relaxed">
    <PolicyNotice topic="prohibited items and moving guidelines" />
    <!-- Key Takeaways Box -->
    <div class="p-6 bg-brand-blue-50 border-2 border-brand-blue-200 rounded-3xl shadow-soft">
      <h2 class="text-lg font-black text-brand-navy mb-3 flex items-center gap-2">
        <span>📌</span>
        <span>The 3 Golden Rules of College Packing</span>
      </h2>
      <ul class="space-y-2 text-xs sm:text-sm text-navy-700">
        <li class="flex items-start gap-2">
          <span class="text-brand-blue font-bold">1.</span>
          <span><strong>Pack for the current semester only:</strong> Do not pack heavy winter parkas and snow boots in August if you are traveling home for Thanksgiving break.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-brand-coral font-bold">2.</span>
          <span><strong>Ditch rigid luggage:</strong> Pack in blue zippered moving bags or collapsible duffels that fold completely flat under a bed.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-brand-mint font-bold">3.</span>
          <span><strong>Move-in Day is chaos:</strong> Keep your first-night bedding, shower shoes, medications, and phone chargers in one dedicated "Day 1 Carry-On".</span>
        </li>
      </ul>
    </div>

    <!-- Visual 4-Column Packing Framework & Carry-on Diagram -->
    <section class="space-y-6">
      <h2 class="text-2xl sm:text-3xl font-black text-brand-navy">
        1. The 4-Way Packing Framework
      </h2>
      <p class="text-xs sm:text-sm text-navy-700">
        Before putting anything into a box, classify every single prospective purchase into one of four columns:
      </p>

      <PackingFramework />
    </section>

    <!-- Roommate Coordination Callout -->
    <VisualCallout type="roommate" title="Roommate Coordination Checklist (Split 50/50)">
      <p>
        Reach out to your assigned roommate 3 to 4 weeks before arrival. Agree in writing on who brings which shared items:
      </p>
      <ul class="list-disc list-inside space-y-1 pt-1 font-medium">
        <li>Mini-fridge &amp; microwave (or rent a MicroFridge unit together)</li>
        <li>Room floor rug (typically 4x6 ft or 5x7 ft)</li>
        <li>Full-length door mirror &amp; ironing steamer</li>
        <li>Television / gaming console &amp; HDMI switch</li>
      </ul>
    </VisualCallout>

    <!-- Fire Code Warning Callout -->
    <VisualCallout type="safety" title="Items Confiscated by Residence Life">
      <p>
        Residence life staff conduct mandatory fire safety checks within the first two weeks of class. Leave these high-risk items at home:
      </p>
      <ul class="list-disc list-inside space-y-1 pt-1 font-medium">
        <li>Candles, wax warmers, and incense (even unburned decorative ones)</li>
        <li>Open-coil cooking appliances (hot plates, toaster ovens, deep fryers)</li>
        <li>Space heaters &amp; air conditioners not provided by the university</li>
        <li>Household ungrounded 2-prong extension cords</li>
      </ul>
    </VisualCallout>

    <!-- Related Planning Guides -->
    <section class="pt-6 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-bold text-brand-blue">
      <a href="/college-move-in-day-checklist/" class="p-4 bg-brand-blue-50/60 rounded-2xl border border-brand-blue-100 hover:bg-brand-blue-50 flex items-center justify-between transition-colors">
        <span>📅 Move-In Day Step-by-Step Checklist</span>
        <span>→</span>
      </a>
      <a href="/community-bathroom-college-essentials/" class="p-4 bg-brand-mint-50/60 rounded-2xl border border-brand-mint-100 hover:bg-brand-mint-50 flex items-center justify-between text-brand-mint-900 transition-colors">
        <span>🚿 Community Bathroom Transit Essentials</span>
        <span>→</span>
      </a>
    </section>
  </div>
</GuideLayout>
