---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs, { type BreadcrumbItem } from '../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import GuideThumbnail from '../components/GuideThumbnail.astro';
import type { FaqItem } from '../components/SeoHead.astro';
import { EDITORIAL_GUIDES } from '../data/guides';
import { SITE_CONFIG } from '../data/site';

export interface Props {
  title: string;
  description: string;
  category: string;
  categoryUrl?: string;
  lastUpdated: string;
  readingTimeMinutes: number;
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FaqItem[];
  currentSlug?: string;
}

const {
  title,
  description,
  category,
  categoryUrl = '/guides/',
  lastUpdated,
  readingTimeMinutes,
  breadcrumbs = [],
  faqs = [],
  currentSlug,
} = Astro.props;

const defaultBreadcrumbs: BreadcrumbItem[] = [
  { name: 'Guides', url: '/guides/' },
  { name: category, url: categoryUrl },
  { name: title, url: Astro.url.pathname },
];

const finalBreadcrumbs = breadcrumbs.length > 0 ? breadcrumbs : defaultBreadcrumbs;

const relatedGuides = EDITORIAL_GUIDES.filter(
  (g) => g.slug !== currentSlug && (g.category === category.toLowerCase() || g.featured)
).slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  modifiedTime={lastUpdated}
  breadcrumbs={finalBreadcrumbs}
  faqs={faqs}
>
  <div class="bg-gradient-to-b from-brand-blue-50/70 via-brand-blue-50/30 to-white border-b border-slate-200 py-10 lg:py-14">
    <div class="container-custom max-w-4xl">
      <Breadcrumbs items={finalBreadcrumbs} />

      <div class="mt-4 flex flex-wrap items-center gap-2.5 text-xs font-bold text-navy-600">
        <a href={categoryUrl} class="badge-blue hover:bg-brand-blue-100 transition-colors">
          {category}
        </a>
        <span>•</span>
        <span>{readingTimeMinutes} min read</span>
        <span>•</span>
        <span>Last reviewed: <time datetime={lastUpdated} class="text-brand-blue">{lastUpdated}</time></span>
      </div>

      <h1 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-black text-brand-navy leading-tight tracking-tight">
        {title}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-navy-700 leading-relaxed font-sans">
        {description}
      </p>

      <div class="mt-6 flex items-center gap-3 pt-6 border-t border-slate-200 text-xs text-navy-600">
        <div class="w-8 h-8 rounded-xl bg-brand-blue text-white flex items-center justify-center font-black text-xs shadow-sm">
          DR
        </div>
        <div>
          <span class="font-bold text-brand-navy">Researched &amp; Maintained by DormReady Editorial Team</span>
          <span class="block text-[11px] text-navy-500">Fact-checked according to our <a href="/editorial-policy/" class="underline text-brand-blue font-semibold hover:text-brand-blue-700">Editorial Standards</a></span>
        </div>
      </div>
    </div>
  </div>

  <div class="container-custom max-w-4xl py-8 lg:py-12">
    <AffiliateDisclosure compact={true} />

    <article class="prose-editorial text-sm sm:text-base leading-relaxed space-y-6">
      <slot />
    </article>

    <!-- Post-article editorial commitment -->
    <div class="mt-14 p-6 sm:p-8 bg-brand-mint-50/60 border-2 border-brand-mint-200 rounded-3xl text-xs sm:text-sm text-navy-700 shadow-soft">
      <h3 class="font-black text-base text-emerald-950 mb-2">Our Editorial Commitment</h3>
      <p class="leading-relaxed mb-3">
        DormReady does not publish sponsored reviews, artificial rankings, or manufacturer-supplied marketing copy. Every dorm guideline is vetted against real residence hall fire codes, communal living constraints, and budget practicalities.
      </p>
      <p class="text-xs text-navy-600">
        Have a correction or college housing policy change? Submit an issue on our <a href={SITE_CONFIG.githubRepoUrl} target="_blank" rel="noopener noreferrer" class="underline text-brand-blue font-bold">GitHub Project</a>.
      </p>
    </div>

    {relatedGuides.length > 0 && (
      <div class="mt-16 pt-12 border-t border-slate-200">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl sm:text-2xl font-black text-brand-navy">Related Preparation Guides</h2>
          <a href="/guides/" class="text-xs font-bold text-brand-blue hover:underline">View all guides →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedGuides.map((g) => (
            <a
              href={g.href}
              class="block bg-white border-2 border-slate-200 hover:border-brand-blue-300 rounded-2xl overflow-hidden shadow-soft hover:shadow-soft-hover transition-all duration-200 hover:-translate-y-1 group"
            >
              <GuideThumbnail slug={g.slug} title={g.title} />
              <div class="p-4">
                <span class="text-[10px] font-black uppercase tracking-wider text-brand-blue block mb-1">{g.categoryLabel}</span>
                <h4 class="font-black text-brand-navy text-xs sm:text-sm group-hover:text-brand-blue transition-colors line-clamp-2 mb-1.5">
                  {g.title}
                </h4>
                <p class="text-[11px] text-navy-600 line-clamp-2">
                  {g.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
